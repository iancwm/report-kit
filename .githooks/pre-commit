#!/usr/bin/env bash
# Runs the relevant fast checks for staged core files.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
changed="$(git diff --cached --name-only)"
status=0

if echo "$changed" | grep -qE '^(latex_templates|python_scripts)/'; then
  echo "pre-commit: latex_templates/ or python_scripts/ changed -- running acceptance check"
  if ! "$ROOT/scripts/acceptance_check.sh"; then
    status=1
  fi
fi

if echo "$changed" | grep -qE '^data_engineering_guide/(scripts|manuscript|fragments)/'; then
  guide_root="$ROOT/data_engineering_guide"
  if [[ -f "$guide_root/manuscript/order.txt" ]]; then
    echo "pre-commit: guide source changed -- running static guide validation"
    if ! python3 "$guide_root/scripts/validate-guide.py"; then
      status=1
    fi
  else
    echo "pre-commit: guide harness changed; source validation deferred until the content branch is assembled"
  fi
fi

if echo "$changed" | grep -qE '^(metadata/licenses\.yml|python_scripts/license_metadata\.py)$'; then
  if ! python3 "$ROOT/python_scripts/license_metadata.py" "$ROOT/metadata/licenses.yml"; then
    status=1
  fi
fi

exit "$status"
