% ReportKit publication type: equity-research -- Step 3 of the institutional
% research theme + equity-research profile spec
% (docs/superpowers/specs/2026-09-09-reportkit-institutional-theme-and-equity-profile-spec.md).
% Front page, rating strip, sidebar, "what changed", exhibit system, table
% grammar, dense financial-model mode, and risk/reward composition
% primitives (spec §7-§18, §23).
%
% Selected via `\documentclass[publication-type=equity-research]{reportkit}`,
% loaded by reportkit.cls after the selected theme and before the four
% always-on semantic modules (reportkit-boxes/-code/-diagrams/-grammar).
% Per the architecture (spec §1), this file owns *structure* -- what an
% equity-research page is made of -- not *style*: every size/color it uses
% is a token the theme defines, never a literal \fontsize or \definecolor of
% its own. That is what makes "publication-type=equity-research,
% theme=institutional-research" and a hypothetical future
% "publication-type=equity-research, theme=modern-minimal" both work without
% rewriting this file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-equity-research}[2026/09/09 v1.0.0 ReportKit equity-research publication type]

\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}
\RequirePackage{needspace}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}

% Only theme=institutional-research defines the twelve \rk...size type-scale
% commands (spec §5) this file's primitives are built on -- see that theme's
% "Type scale" section. Fail here, at load time, with a clear message,
% rather than letting the first \researchheadline (or whichever primitive a
% document happens to use first) hit a raw "Undefined control sequence
% \rkheadlinesize" deep in the document body. This is a TeX-level guard in
% the same spirit as the institutional theme's own \ifPDFTeX engine guard --
% fail at the point the actual requirement is knowable, not later and
% unclearly.
\@ifundefined{rkheadlinesize}{%
  \PackageError{reportkit-equity-research}%
    {publication-type=equity-research requires a theme that defines the spec's \MessageBreak\string\rkheadlinesize\space type-scale commands (spec section 5) -- only theme=institutional-research does today}%
    {Add theme=institutional-research to \string\documentclass's options.}%
}{}

% -----------------------------------------------------------------------------
% Table column types (spec §16) -- ragged-right / ragged-left / centered
% expandable columns for tabularx, matching Appendix A's Y/Z/C convention.
% -----------------------------------------------------------------------------
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{Z}{>{\RaggedLeft\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}

% Institutional table grammar (spec §16): no vertical borders (use booktabs
% \toprule/\midrule/\bottomrule, never \vline), header weight instead of
% colored panels (\bfseries the header row, don't \rowcolor it), right-align
% numeric columns (r or Z), decimal alignment where practical (siunitx's S
% column type, already available -- siunitx is required by
% reportkit-core.sty), and a muted source line (\source{}, theme-provided).
% This is deliberately one generic environment, not six named ones
% (financial-summary/estimate-revisions/valuation/sensitivity/
% scenario-analysis/financial-model, per spec §16's list): those differ only
% in column count and content, not in typographic grammar, and hard-coding
% six fixed column layouts without real fixture data to validate them
% against (Step 5) risks shipping tables that are wrong for the first real
% publication that uses them. financialtable is a typographic context, not
% a table environment itself -- open a tabularx/tabular (with booktabs rules
% and Y/Z/C/S columns) inside it for any of the six, e.g.
% \begin{financialtable}\begin{tabularx}{\linewidth}{@{}Yrrr@{}}...
% \end{tabularx}\end{financialtable}.
\NewDocumentEnvironment{financialtable}{}{%
  \par\Needspace{5\baselineskip}\noindent
  \sffamily\rktablebodysize\color{Ink}
  \renewcommand{\arraystretch}{1.05}
  \sisetup{table-format=-3.2}%
  \ignorespaces
}{%
  \par\vspace{4pt}%
}

% -----------------------------------------------------------------------------
% Research front page (spec §7)
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{researchfrontpage}{}{%
  \thispagestyle{fancy}%
  \vspace*{1mm}%
}{%
  \par\vspace{6pt}%
}

\newcommand{\researchkicker}[1]{{\sffamily\bfseries\rksectorkickersize\color{Accent}#1\par}\vspace{5pt}}
\newcommand{\researchheadline}[1]{{\sffamily\bfseries\rkheadlinesize\color{Ink}#1\par}\vspace{6pt}}
\newcommand{\researchdeck}[1]{{\rkdecksize\color{Ink}\RaggedRight #1\par}\vspace{7pt}}

% -----------------------------------------------------------------------------
% Rating strip (spec §9) -- a plain horizontal informational strip, not the
% old dashboard-style BUY card: hairlines above/below, thin vertical
% separators between items, no rounded rectangle, at most one accent color
% (left to the caller -- wrap a value in \color{Accent} to use it), and the
% price target is not rendered as a giant KPI (it shares \rkratingvaluesize
% with every other item in the strip).
% -----------------------------------------------------------------------------
\newcounter{rkratingitem}
\NewDocumentEnvironment{ratingstrip}{}{%
  \par\Needspace{4\baselineskip}\noindent
  \setcounter{rkratingitem}{0}%
  {\color{Hairline}\hrule height 0.4pt}\par\vspace{5pt}\noindent
}{%
  \par\vspace{3pt}{\color{Hairline}\hrule height 0.4pt}\par\vspace{6pt}%
}

\NewDocumentCommand{\ratingitem}{m m}{%
  \stepcounter{rkratingitem}%
  \ifnum\value{rkratingitem}>1\quad{\color{Hairline}\vrule width 0.4pt}\quad\fi
  \begin{minipage}[t]{0.29\linewidth}%
    {\sffamily\rksidebarsize\color{Muted}\MakeUppercase{#1}\par}%
    \vspace{1pt}{\sffamily\bfseries\rkratingvaluesize\color{Ink}#2\par}%
  \end{minipage}%
}

% -----------------------------------------------------------------------------
% Two-column research body (spec §7) -- main ~68%, gutter ~4%, sidebar ~28%.
% researchmain and researchsidebar are two *adjacent* minipages realized as
% sibling environments, not one wrapper containing both: put
% \end{researchmain} immediately before \begin{researchsidebar} with no
% blank line between them in the source. A blank line starts a new
% paragraph, which breaks LaTeX out of horizontal mode and moves the sidebar
% below the main column instead of beside it -- the same constraint any
% \hfill-separated pair of minipages has. The ~4% gutter is realized as
% \hfill's stretch between two fixed-width boxes (0.68 + 0.28 = 0.96
% \linewidth) rather than a hard-coded gutter width.
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{researchmain}{}{%
  \par\noindent\begin{minipage}[t]{0.68\linewidth}%
}{%
  \end{minipage}%
}
\NewDocumentEnvironment{researchsidebar}{}{%
  \hfill\begin{minipage}[t]{0.28\linewidth}%
}{%
  \end{minipage}\par\vspace{8pt}%
}

% -----------------------------------------------------------------------------
% Sidebar primitives (spec §8) -- small font, thin horizontal separators,
% compact row spacing, no rounded boxes, no colored background by default;
% labels muted, values Ink, accent reserved for important state (left to the
% caller, same as \ratingitem).
% -----------------------------------------------------------------------------
\newcommand{\sidebarlabel}[1]{{\sffamily\fontsize{6.2pt}{7.4pt}\selectfont\color{Muted}\MakeUppercase{#1}}}
\newcommand{\sidebarvalue}[1]{{\sffamily\rksidebarsize\bfseries\color{Ink}#1}}
\newcommand{\sidebarrule}{\par\vspace{2pt}{\color{Hairline}\hrule height 0.4pt}\vspace{3pt}}
\NewDocumentCommand{\sidebarrow}{m m}{%
  \par\noindent\sidebarlabel{#1}\hfill\sidebarvalue{#2}\par\vspace{2pt}%
}

\NewDocumentEnvironment{analystblock}{}{%
  \par\Needspace{4\baselineskip}\noindent\sffamily\rksidebarsize\color{Ink}\ignorespaces
}{%
  \par\vspace{6pt}%
}
\NewDocumentEnvironment{marketdatablock}{}{%
  \sidebarrule\noindent\sffamily\rksidebarsize\color{Ink}\ignorespaces
}{%
  \par\vspace{6pt}%
}
\NewDocumentEnvironment{estimatesblock}{}{%
  \sidebarrule\noindent\sffamily\rksidebarsize\color{Ink}\ignorespaces
}{%
  \par\vspace{6pt}%
}

% -----------------------------------------------------------------------------
% "What Changed?" (spec §10) -- small accent label, From/To columns, minimal
% rules, no card container. A reusable research primitive, not
% equity-specific hand formatting.
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{whatschanged}{}{%
  \par\Needspace{5\baselineskip}\vspace{3pt}%
  {\sffamily\bfseries\rksidebarsize\color{Accent}\MakeUppercase{What's Changed?}\par}%
  \vspace{3pt}{\color{Hairline}\hrule height 0.4pt}\vspace{4pt}\noindent
  \sffamily\rksidebarsize\color{Ink}\ignorespaces
}{%
  \par\vspace{2pt}{\color{Hairline}\hrule height 0.4pt}\vspace{6pt}%
}
\NewDocumentCommand{\change}{m m m}{%
  \noindent#1\hfill\textcolor{Muted}{#2}\;$\to$\;\textbf{#3}\par\vspace{1.5pt}%
}

% -----------------------------------------------------------------------------
% Exhibit system (spec §11) -- the most important new primitive. Auto-
% numbered via \refstepcounter (so \label/\ref work normally); number= can
% override the displayed number for a document that numbers exhibits itself
% (e.g. across a combined publication built from independently-numbered
% sections), without disturbing the counter other exhibits still auto-
% increment from.
% -----------------------------------------------------------------------------
\newcounter{rkexhibit}
\pgfkeys{
  /reportkit/exhibit/.is family,
  /reportkit/exhibit,
  number/.store in=\rk@exhibitnumber,
  title/.store in=\rk@exhibittitle,
  source/.store in=\rk@exhibitsource,
  label/.store in=\rk@exhibitlabel,
}
\NewDocumentEnvironment{exhibit}{O{}}{%
  \pgfkeys{/reportkit/exhibit,number={},title={},source={},label={},#1}%
  \ifstrempty{\rk@exhibittitle}{%
    \PackageWarningNoLine{reportkit-equity-research}{exhibit used without title= -- spec section 11 requires one}%
  }{}%
  \par\Needspace{9\baselineskip}%
  \refstepcounter{rkexhibit}%
  \noindent{\sffamily\bfseries\rkexhibitheadlinesize\color{Ink}%
    Exhibit \ifstrempty{\rk@exhibitnumber}{\therkexhibit}{\rk@exhibitnumber}: \rk@exhibittitle\par}%
  \ifstrempty{\rk@exhibitlabel}{}{\label{\rk@exhibitlabel}}%
  \vspace{3pt}\noindent
}{%
  \par
  \ifstrempty{\rk@exhibitsource}{}{\source{\rk@exhibitsource}}%
  \vspace{6pt}%
}

% -----------------------------------------------------------------------------
% Exhibit page compositions (spec §12). Supported layouts:
%   1 x full width          -> fullwidthexhibit (or just place \exhibit at
%                               the main column's full width -- it already
%                               defaults to that; fullwidthexhibit exists so
%                               a page composed mostly of exhibitpair/grid
%                               blocks can mark one as deliberately full
%                               width without changing indentation).
%   2 x half width           -> exhibitpair (exactly two \exhibitpane{...})
%   N equal columns          -> exhibitgrid[columns=N] (N \exhibitpane{...})
%   1 dominant + 2 supporting -> compose fullwidthexhibit followed by
%                               exhibitpair, per spec §12's "avoid generic
%                               dashboard grids" instruction: this is a
%                               composition of the two primitives above, not
%                               a third environment.
%   2 exhibits + full-width table -> exhibitpair followed by a plain
%                               \begin{exhibit}...\end{exhibit} containing a
%                               financialtable, for the same reason.
% Avoid generic dashboard grids: exhibitgrid does not stretch content to
% fill unused columns, and deliberate whitespace (fewer panes than columns)
% is left as-is, not redistributed.
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{fullwidthexhibit}{}{%
  \par\noindent\begin{minipage}[t]{\linewidth}%
}{%
  \end{minipage}\par\vspace{8pt}%
}

\newcounter{rkexhibitpane}
\pgfkeys{
  /reportkit/exhibitgrid/.is family,
  /reportkit/exhibitgrid,
  columns/.store in=\rk@exhibitpanecols,
}
\pgfkeys{
  /reportkit/exhibitpane/.is family,
  /reportkit/exhibitpane,
  width/.store in=\rk@exhibitpanewidth,
}
\newcommand{\rk@exhibitpanecols}{2}
\newcommand{\rk@exhibitpanewidth}{}

\NewDocumentEnvironment{exhibitgrid}{O{}}{%
  \pgfkeys{/reportkit/exhibitgrid,columns=2,#1}%
  \par\noindent\setcounter{rkexhibitpane}{0}%
}{%
  \par\vspace{10pt}%
}
% exhibitpair is exhibitgrid[columns=2] under another name -- \exhibitgrid/
% \endexhibitgrid are the control sequences \NewDocumentEnvironment defined
% above for it, callable directly without \begin{}/\end{} the same way
% \begin{exhibitgrid} itself expands to \exhibitgrid.
\NewDocumentEnvironment{exhibitpair}{}{%
  \exhibitgrid[columns=2]%
}{%
  \endexhibitgrid
}

% Pane widths are literal fraction constants for columns=1/2/3 (linewidth,
% 0.485\linewidth x2, 0.313\linewidth x3 -- each leaving a ~3% gutter,
% matching Appendix A's own 0.485\linewidth two-up split), not a computed
% \dimexpr: this file cannot be compile-tested in the implementing session,
% and arithmetic on \linewidth inside \dimexpr is exactly the kind of thing
% that's easy to get subtly wrong without a compiler to check it against.
% columns=4+ (or a non-uniform split, e.g. one dominant pane) needs an
% explicit width= on every \exhibitpane in the grid instead.
\NewDocumentCommand{\exhibitpane}{O{} m}{%
  \stepcounter{rkexhibitpane}%
  \pgfkeys{/reportkit/exhibitpane,width={},#1}%
  \ifnum\value{rkexhibitpane}>1\hfill\fi
  \ifstrempty{\rk@exhibitpanewidth}{%
    \ifcase\rk@exhibitpanecols\relax
      \PackageError{reportkit-equity-research}{exhibitgrid columns=0 is not usable}{Use columns=1, 2, or 3, or pass width=<fraction>\string\linewidth on every \string\exhibitpane.}%
    \or % columns=1
      \def\rk@exhibitpanew{\linewidth}%
    \or % columns=2
      \def\rk@exhibitpanew{0.485\linewidth}%
    \or % columns=3
      \def\rk@exhibitpanew{0.313\linewidth}%
    \else
      \PackageError{reportkit-equity-research}{exhibitgrid only computes pane widths for columns=1, 2, or 3}{Pass width=<fraction>\string\linewidth on every \string\exhibitpane when using more columns.}%
    \fi
  }{%
    \def\rk@exhibitpanew{\rk@exhibitpanewidth}%
  }%
  \begin{minipage}[t]{\rk@exhibitpanew}%
  #2%
  \end{minipage}%
}

% -----------------------------------------------------------------------------
% Financial model page (spec §17) -- editorial prose pages optimize reading;
% model pages optimize scanning. Locally (not globally -- everything reverts
% at \end{financialmodelpage}) drops to dense table type and tighter row
% spacing, while keeping the same font family, palette, exhibit/title
% grammar, and headers/footers as the rest of the document. True landscape
% rotation (spec §17's "landscape if required") is deliberately not
% implemented here: getting \newgeometry/\restoregeometry or pdflscape's
% page-rotation semantics right is not something this change can verify
% without a compiler, and a wide model table can usually be handled with
% \rktablebodysize plus a resizebox instead. A page that genuinely needs
% physical landscape can wrap itself in `pdflscape`'s `landscape`
% environment around this one; that composition doesn't require anything
% from this file.
% -----------------------------------------------------------------------------
\NewDocumentEnvironment{financialmodelpage}{}{%
  \begingroup
  \renewcommand{\arraystretch}{0.92}%
  \setlength{\tabcolsep}{2.5pt}%
  \sffamily\fontsize{7.6pt}{9pt}\selectfont
}{%
  \endgroup
}

% -----------------------------------------------------------------------------
% Risk/reward primitive (spec §18). The chart itself is deliberately not
% drawn here: spec §18 itself prefers generating it "through
% reportkit_viz.py" (Step 4), and drawing it in raw TikZ/pgfplots here would
% be exactly the "bespoke chart styling" spec §28's Definition of Done rules
% out. Embed a reportkit_viz-generated chart the same way any other exhibit
% embeds a figure: \begin{exhibit}[...]\includegraphics{...}\end{exhibit}.
% The page composition around it -- Investment Thesis / Key Debates /
% Catalysts / Risks beside the chart -- reuses researchmain/researchsidebar
% (spec §7): Appendix A's risk/reward page uses the same ~68/28 column split
% as its front page, so this file does not duplicate that layout under a
% second name.
% -----------------------------------------------------------------------------
\newcommand{\rksubheading}[1]{\par\vspace{6pt}{\sffamily\bfseries\rksidebarsize\color{Accent}\MakeUppercase{#1}\par}\vspace{3pt}}

\NewDocumentCommand{\rkscenario}{m m m m}{%
  \par\noindent{\sffamily\bfseries\rksubsectionsize\color{Ink}#1\hfill\textcolor{#2}{#3}\par}%
  \vspace{2pt}{\rkbodysize\color{Ink}#4\par}\vspace{6pt}%
}
\NewDocumentCommand{\bullcase}{m m}{\rkscenario{Bull}{SeriesGold}{#1}{#2}}
\NewDocumentCommand{\basecase}{m m}{\rkscenario{Base}{Accent}{#1}{#2}}
\NewDocumentCommand{\bearcase}{m m}{\rkscenario{Bear}{BearRed}{#1}{#2}}

\endinput
