% ReportKit publication type: equity-research -- Step 3 of the institutional
% research theme + equity-research profile spec
% (docs/superpowers/specs/2026-09-09-reportkit-institutional-theme-and-equity-profile-spec.md).
% Front page, rating strip, sidebar, "what changed", dense financial-model
% mode, and risk/reward composition primitives (spec §7-§18, §23). The
% exhibit system and table grammar live in the shared reportkit-exhibits.sty
% (required below), which executive-brief also loads.
%
% Selected via `\documentclass[publication-type=equity-research]{reportkit}`,
% loaded by reportkit.cls after the selected theme and before the four
% always-on semantic modules (reportkit-boxes/-code/-diagrams/-grammar).
% Per the architecture (spec §1), this file owns *structure* -- what an
% equity-research page is made of -- not *style*: every size/color it uses
% is a token the theme defines, never a literal \fontsize or \definecolor of
% its own. That is what makes "publication-type=equity-research,
% theme=institutional-research" and a hypothetical future
% "publication-type=equity-research, theme=modern-minimal" both work without
% rewriting this file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-equity-research}[2026/09/13 v1.0.1 ReportKit equity-research publication type]

\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}

% Only theme=institutional-research defines the twelve \rk...size type-scale
% commands (spec §5) this file's primitives are built on -- see that theme's
% "Type scale" section. Fail here, at load time, with a clear message,
% rather than letting the first \researchheadline (or whichever primitive a
% document happens to use first) hit a raw "Undefined control sequence
% \rkheadlinesize" deep in the document body. This is a TeX-level guard in
% the same spirit as the institutional theme's own \ifPDFTeX engine guard --
% fail at the point the actual requirement is knowable, not later and
% unclearly.
\@ifundefined{rkheadlinesize}{%
  \PackageError{reportkit-equity-research}%
    {publication-type=equity-research requires a theme that defines the spec's \MessageBreak\string\rkheadlinesize\space type-scale commands (spec section 5) -- only theme=institutional-research does today}%
    {Add theme=institutional-research to \string\documentclass's options.}%
}{}

% The exhibit system (spec §11-§12) and institutional table grammar (spec
% §16) moved verbatim into reportkit-exhibits.sty so executive-brief can reuse
% them without loading equity-research's front-page/sidebar structure. Loaded
% at the same point their definitions previously occupied in this file.
\RequirePackage{reportkit-exhibits}

