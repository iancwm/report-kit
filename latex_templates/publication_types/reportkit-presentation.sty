% ReportKit publication type: presentation. Phase B of the multi-format
% publication architecture spec (decision B2): "reportkit-presentation.sty
% owns semantic structures, not visual values." Every composition below
% delegates its actual spacing/type/rule/color to the theme's
% presentation-token contract (reportkit-core.sty's "Presentation-composition
% style tokens" section, populated by a slides-compatible theme's adapter --
% today only reportkit-theme-executive-slides.sty) or to plain semantic color
% names every slides-compatible theme is expected to define (Ink, Muted,
% Hairline, Accent), never to a hardcoded value or a theme name. No
% composition below mentions "executive": venture (Phase D) is expected to
% compile the same compositions unchanged, using its own adapter's token
% values -- the same proof D11/Phase D already requires for paged themes.
%
% Every composition below is CONTENT ONLY -- none of them opens or closes
% Beamer's own \begin{frame}...\end{frame}; the author (or the pipeline's
% front-matter hook) wraps each one in an explicit frame, e.g.:
%   \begin{frame}
%   \begin{messageslide}{Example}
%   Example content.
%   \end{messageslide}
%   \end{frame}
% This is not a stylistic choice: Beamer's frame environment captures its own
% body by scanning the raw input stream for a literally-typed \end{frame},
% the same mechanism "fragile" frames use for listings/verbatim content --
% verified empirically (a version opening \begin{frame}[fragile] in one
% custom environment's start code and \end{frame} in its end code fails with
% "Runaway argument? File ended while scanning use of \beamer@collect@@body",
% even with no fragile content at all in the frame; the same content wrapped
% by an explicit, literal \begin{frame}...\end{frame} compiles cleanly). Add
% [fragile] to the author's own \begin{frame} when its content needs it
% (e.g. a codeblock) -- these compositions do not decide that for the
% author's frame the way a frame-opening design would have had to.
%
% Only ever loaded when publication-type=presentation, which only ever pairs
% with a slides-renderer theme (the registry rejects any other pairing), so
% this file is free to use Beamer's own environments (columns, column)
% directly -- unlike reportkit-boxes.sty/reportkit-diagrams.sty, which must
% compile under either renderer core.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-presentation}[2026/09/20 v1.0.0 ReportKit presentation compositions]
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{pgfkeys}

\RKAssertPresentationTokens

% Bounded assertion measurement state. The public compositions use measured
% TeX boxes and discrete fit states; they never continuously shrink a
% headline or the evidence body.
\newsavebox{\rkpresentation@assertionbox}
\newlength{\rkpresentation@assertionheight}
\newcommand{\rkpresentation@kicker}{}
\newcommand{\rkpresentation@fitfont}{}
\newcommand{\rkpresentation@fitstate}{}
\newcounter{rkpresentation@references}
\pgfkeys{
  /reportkit/assertionslide/.is family,
  /reportkit/assertionslide/.cd,
  kicker/.store in=\rkpresentation@kicker,
}
\newcommand{\rkpresentation@measureheader}[3]{%
  \setbox\rkpresentation@assertionbox=\vbox{%
    \hsize=\linewidth
    \parindent=0pt
    \leftskip=0pt
    \rightskip=0pt plus 1fil
    \parfillskip=0pt
    \ifdefempty{\rkpresentation@kicker}{}{%
      {\sffamily\bfseries\RKTokPresentationKickerFont\color{Accent}\MakeUppercase{\rkpresentation@kicker}\par}%
      \vskip 1.5mm
    }%
    {\sffamily\bfseries#1\color{Ink}#2\par}%
    \ifdefempty{#3}{}{%
      \vskip 1.5mm
      {\sffamily\RKTokPresentationAssertionDeckFont\color{Muted}#3\par}%
    }%
  }%
  \setlength{\rkpresentation@assertionheight}{\dimexpr\ht\rkpresentation@assertionbox+\dp\rkpresentation@assertionbox\relax}%
}
\newcommand{\rkpresentation@fitassertion}[2]{%
  \rkpresentation@measureheader{\RKTokPresentationAssertionFont}{#1}{#2}%
  \ifdim\rkpresentation@assertionheight>\RKTokPresentationAssertionHeaderMaxHeight
    \rkpresentation@measureheader{\RKTokPresentationAssertionCompactFont}{#1}{#2}%
    \ifdim\rkpresentation@assertionheight>\RKTokPresentationAssertionHeaderMaxHeight
      \def\rkpresentation@fitfont{\RKTokPresentationAssertionCompactFont}%
      \def\rkpresentation@fitstate{invalid}%
      \typeout{REPORTKIT-PRESENTATION-ASSERTION-FIT=invalid}%
      \PackageError{reportkit-presentation}{PRESENTATION_ASSERTION_TOO_LONG}{%
        The assertion exceeds the compact headline envelope. Rewrite the assertion or split the slide; body text will not be compressed.}%
    \else
      \def\rkpresentation@fitfont{\RKTokPresentationAssertionCompactFont}%
      \def\rkpresentation@fitstate{compact}%
      \typeout{REPORTKIT-PRESENTATION-ASSERTION-FIT=compact}%
    \fi
  \else
    \def\rkpresentation@fitfont{\RKTokPresentationAssertionFont}%
    \def\rkpresentation@fitstate{standard}%
    \typeout{REPORTKIT-PRESENTATION-ASSERTION-FIT=standard}%
  \fi
}


