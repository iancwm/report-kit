% </reportkit-contract>
\NewDocumentEnvironment{titleslide}{}{%
  \vfill
  {\sffamily\RKTokPresentationKickerFont\bfseries\color{Accent}\MakeUppercase{\rk@leftheader}\par}
  \vspace{4mm}
  {\sffamily\bfseries\RKTokPresentationTitleFont\color{Ink}\inserttitle\par}
  \ifdefempty{\insertsubtitle}{}{\vspace{2mm}{\sffamily\RKTokPresentationSubtitleFont\color{Muted}\insertsubtitle\par}}%
  \vspace{6mm}
  \ifdefempty{\insertauthor}{}{{\sffamily\RKTokPresentationBodyFont\color{Muted}\insertauthor}}%
  \ifdefempty{\insertdate}{}{{\sffamily\RKTokPresentationBodyFont\color{Muted}\ifdefempty{\insertauthor}{}{\quad\textperiodcentered\quad}\insertdate}}%
}{%
  \vfill
}

