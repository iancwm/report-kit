% <reportkit-contract>
% {"kind":"composition","description":"Assertionslide","arguments":[{"name":"options","type":"options","description":"Optional key list; currently supports kicker={...}."},{"name":"assertion","type":"text","description":"The single working-slide assertion."},{"name":"deck","type":"text","description":"Optional short supporting sentence in the deck hierarchy."}],"constraints":[{"code":"content_only_wrap_in_frame","description":"Content only; wrap in \begin{frame}...\end{frame}."},{"code":"bounded_assertion_header","description":"The header is measured and reserved at a fixed maximum height; body typography is not reduced to rescue an invalid assertion."},{"code":"fit_states","description":"The assertion resolves to standard, compact, or invalid; invalid emits PRESENTATION_ASSERTION_TOO_LONG."}],"example":"\begin{frame}\n\begin{assertionslide}[kicker={Parenting constitution}]{Six household rules prevent most major unforced errors.}[Agree on these before you are tired.]\nEvidence body.\n\end{assertionslide}\n\end{frame}","stability":"stable","since":"1.9.3"}
% </reportkit-contract>
\NewDocumentEnvironment{assertionslide}{O{} m O{}}{%
  \pgfkeys{/reportkit/assertionslide/.cd,kicker={},#1}%
  \rkpresentation@fitassertion{#2}{#3}%
  \begin{minipage}[t][\RKTokPresentationAssertionHeaderMaxHeight][t]{\linewidth}
    \ifdefempty{\rkpresentation@kicker}{}{%
      {\sffamily\bfseries\RKTokPresentationKickerFont\color{Accent}\MakeUppercase{\rkpresentation@kicker}\par}%
      \vspace{1.5mm}%
    }%
    {\sffamily\bfseries\rkpresentation@fitfont\color{Ink}#2\par}%
    \ifdefempty{#3}{}{%
      \vspace{1.5mm}%
      {\sffamily\RKTokPresentationAssertionDeckFont\color{Muted}#3\par}%
    }%
  \end{minipage}\par
  \vspace{3mm}%
  {\sffamily\RKTokPresentationBodyFont\color{Ink}}%
}{%
  \par
}

% <reportkit-contract>
% {"kind":"composition","description":"Referenceslide","arguments":[{"name":"title","type":"text","description":"Compact heading for the references frame."},{"name":"note","type":"text","description":"Optional usage or limitation note."}],"constraints":[{"code":"content_only_wrap_in_frame","description":"Content only; wrap in \begin{frame}...\end{frame}."},{"code":"reference_count","description":"Use 3–8 referenceitem calls; more than eight emits a hard overflow diagnostic and should continue on another slide."},{"code":"readable_source","description":"Reference items use the theme-owned source font and are never silently shrunk below it."}],"example":"\begin{frame}\n\begin{referenceslide}{Sources and use}[Short usage note.]\n\referenceitem{Author (2026), Title. \\\\url{https://example.com}}\n\end{referenceslide}\n\end{frame}","stability":"stable","since":"1.9.3"}
% </reportkit-contract>
\NewDocumentEnvironment{referenceslide}{m O{}}{%
  \setcounter{rkpresentation@references}{0}%
  {\sffamily\bfseries\RKTokPresentationAssertionFont\color{Ink}#1\par}%
  \vspace{3mm}%
  {\sffamily\RKTokPresentationSourceFont\color{Ink}}%
}{%
  \ifdefempty{#2}{}{%
    \vspace{2mm}%
    {\sffamily\RKTokPresentationAnnotationFont\color{Muted}\textit{#2}\par}%
  }%
}
\NewDocumentCommand{\referenceitem}{m}{%
  \stepcounter{rkpresentation@references}%
  \ifnum\value{rkpresentation@references}>8
    \PackageError{reportkit-presentation}{PRESENTATION_REFERENCES_OVERFLOW}{%
      More than eight references were supplied; continue on another referenceslide.}%
  \fi
  \par\noindent\hangindent=5mm\hangafter=1
  {\color{Accent}\textbullet}\hspace{2mm}#1\par\vspace{1.2mm}%
}

