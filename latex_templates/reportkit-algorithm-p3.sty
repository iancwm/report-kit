  \@ifundefined{rk@list@x@#3}{\rk@pthree@unknownid{linkedliststate}{#3}{\string\nextlink}}{}%
  \advance\rk@listlinkcount by 1\relax
  \expandafter\edef\csname rk@list@link@source@\the\rk@listlinkcount\endcsname{#2}%
  \expandafter\edef\csname rk@list@link@target@\the\rk@listlinkcount\endcsname{#3}%
  \expandafter\protected@edef\csname rk@list@link@label@\the\rk@listlinkcount\endcsname{\rk@listlinklabel}%
}
\let\listlink\nextlink
