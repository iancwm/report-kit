}

% <reportkit-contract>
% {"kind":"command","description":"Mark a find traversal from a node toward its representative.","arguments":[{"name":"options","type":"options","description":"Optional label=; FIND is the default label."},{"name":"from","type":"text","description":"Starting node id."},{"name":"to","type":"text","description":"Representative node id."}],"constraints":[{"code":"inside_unionfindstate","description":"Only valid inside unionfindstate."},{"code":"known_node_ids","description":"Both ids must already be declared with ufnode."}],"example":"\\findpath{D}{A}","stability":"experimental","since":"1.10.0","parent":"unionfindstate"}
