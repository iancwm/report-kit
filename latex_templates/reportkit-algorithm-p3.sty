}

% <reportkit-contract>
% {"kind":"command","description":"Mark the tail node of a linked list; an explicit TAIL label and NULL terminator are rendered.","arguments":[{"name":"id","type":"text","description":"Tail node id."}],"constraints":[{"code":"inside_linkedliststate","description":"Only valid inside linkedliststate."},{"code":"known_node_id","description":"id must be declared with listnode."}],"example":"\\tail{c}","stability":"experimental","since":"1.10.0","parent":"linkedliststate"}
% </reportkit-contract>
\NewDocumentCommand{\tail}{m}{%
  \@ifundefined{rk@list@x@#1}{\rk@pthree@unknownid{linkedliststate}{#1}{\string\tail}}{\edef\rk@listtail{#1}}%
}

\newcommand{\rk@listrenderlinks}{%
  \ifnum\rk@listlinkcount>0
    \foreach \rk@i in {1,...,\the\rk@listlinkcount}{%
      \edef\rk@listlabel{\csname rk@list@link@label@\rk@i\endcsname}%
      \ifx\rk@listlabel\@empty
        \draw[rk algo graph edge] (\csname rk@list@link@source@\rk@i\endcsname) -- (\csname rk@list@link@target@\rk@i\endcsname);%
      \else
        \draw[rk algo graph edge] (\csname rk@list@link@source@\rk@i\endcsname) -- node[rk edge label]{\rk@listlabel} (\csname rk@list@link@target@\rk@i\endcsname);%
      \fi
    }%
  \fi
}
\newcommand{\rk@listrendermarkers}{%
  \ifdefstring{\rk@listdirection}{vertical}{%
    \draw[rk algo pointer] (\rk@listhead.north) -- ++(0,.56);
    \node[rk algo pointer label,anchor=south] at ([yshift=.60cm]\rk@listhead.north) {HEAD};
    \draw[rk algo pointer] (\rk@listtail.south) -- ++(0,-.56);
    \node[rk algo pointer label,anchor=north] at ([yshift=-.60cm]\rk@listtail.south) {TAIL};
    \draw[rk algo graph edge] (\rk@listtail.south) -- ++(0,-.92) node[rk edge label,anchor=north] {NULL};
  }{%
    \draw[rk algo pointer] (\rk@listhead.north) -- ++(0,.56);
    \node[rk algo pointer label,anchor=south] at ([yshift=.60cm]\rk@listhead.north) {HEAD};
    \draw[rk algo pointer] (\rk@listtail.south) -- ++(0,-.56);
    \node[rk algo pointer label,anchor=north] at ([yshift=-.60cm]\rk@listtail.south) {TAIL};
    \draw[rk algo graph edge] (\rk@listtail.east) -- ++(.92,0) node[rk edge label,anchor=west] {NULL};
  }%
}

