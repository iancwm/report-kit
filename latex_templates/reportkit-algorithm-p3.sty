% <reportkit-contract>
% {"kind":"command","description":"Place one disjoint-set node on the automatic layout grid.","arguments":[{"name":"options","type":"options","description":"state= one of the nine shared algorithm states."},{"name":"id","type":"text","description":"Node id referenced by parent, union, and findpath."},{"name":"label","type":"text","description":"Node label."}],"constraints":[{"code":"inside_unionfindstate","description":"Only valid inside unionfindstate."}],"example":"\\ufnode[state=current]{D}{D}","stability":"experimental","since":"1.10.0","parent":"unionfindstate"}
% </reportkit-contract>
\NewDocumentCommand{\ufnode}{O{} m m}{%
  \@ifundefined{rk@uf@x@#2}{%
    \pgfkeys{/reportkit/ufnode,state={},#1}%
    \rk@setalgostate{\rk@ufnodestate}%
    \pgfmathsetmacro{\rk@ufx}{mod(\the\rk@ufindex,\rk@ufcolumns)*\rk@ufxstep}%
    \pgfmathsetmacro{\rk@ufy}{-floor(\the\rk@ufindex/\rk@ufcolumns)*\rk@ufystep}%
    \node[rk algo graph node,\rk@algostateoverlay] (#2) at (\rk@ufx,\rk@ufy) {\strut #3};%
    \@namedef{rk@uf@x@#2}{\rk@ufx}%
    \@namedef{rk@uf@y@#2}{\rk@ufy}%
    \@namedef{rk@uf@label@#2}{#3}%
    \advance\rk@ufindex by 1\relax
  }{%
    \PackageError{reportkit-algorithm-p3}{Duplicate unionfind node id '#2'}{Use unique ids so parent and find operations are unambiguous.}%
  }%
}

% <reportkit-contract>
% {"kind":"command","description":"Draw a parent pointer from a child node to its representative or parent node.","arguments":[{"name":"options","type":"options","description":"Optional label= for the parent edge."},{"name":"child","type":"text","description":"Child node id."},{"name":"parent","type":"text","description":"Parent or representative node id."}],"constraints":[{"code":"inside_unionfindstate","description":"Only valid inside unionfindstate."},{"code":"known_node_ids","description":"Both ids must already be declared with ufnode."}],"example":"\\parent{B}{A}","stability":"experimental","since":"1.10.0","parent":"unionfindstate"}
% </reportkit-contract>
\NewDocumentCommand{\parent}{O{} m m}{%
  \pgfkeys{/reportkit/ufedge,label={},#1}%
  \rk@ufrequireids{#2}{#3}{\string\parent}%
  \advance\rk@ufparentcount by 1\relax
  \expandafter\edef\csname rk@uf@parent@child@\the\rk@ufparentcount\endcsname{#2}%
  \expandafter\edef\csname rk@uf@parent@parent@\the\rk@ufparentcount\endcsname{#3}%
  \expandafter\protected@edef\csname rk@uf@parent@label@\the\rk@ufparentcount\endcsname{\rk@ufedgelabel}%
}

% <reportkit-contract>
% {"kind":"command","description":"Show a union operation between two representatives or components.","arguments":[{"name":"options","type":"options","description":"Optional label=; UNION is the default label."},{"name":"left","type":"text","description":"First representative or component node id."},{"name":"right","type":"text","description":"Second representative or component node id."}],"constraints":[{"code":"inside_unionfindstate","description":"Only valid inside unionfindstate."},{"code":"known_node_ids","description":"Both ids must already be declared with ufnode."}],"example":"\\union{A}{C}","stability":"experimental","since":"1.10.0","parent":"unionfindstate"}
