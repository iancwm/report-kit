% <reportkit-contract>
% {"kind":"figure","description":"Singly linked-list state with automatic node placement, next pointers, explicit HEAD and TAIL markers, and a NULL terminator.","arguments":[{"name":"options","type":"options","description":"direction=horizontal|vertical and spacing= layout keys."}],"constraints":[{"code":"at_least_one_node","description":"At least one listnode declaration is required."}],"example":"\\begin{diagram}[type=linked-list,caption={Linked-list traversal.},description={Three linked nodes run from HEAD to TAIL and terminate at NULL; the middle node is current.}]\n\\begin{linkedliststate}\n\\listnode{a}{A}\n\\listnode[state=current]{b}{B}\n\\listnode{c}{C}\n\\nextlink{a}{b}\n\\nextlink{b}{c}\n\\head{a}\n\\tail{c}\n\\end{linkedliststate}\n\\end{diagram}","stability":"experimental","since":"1.10.0"}
% </reportkit-contract>
\NewDocumentEnvironment{linkedliststate}{O{}}{%
  \begingroup
  \pgfkeys{/reportkit/linkedliststate,direction=horizontal,spacing=1.75,#1}%
  \rk@listindex=0\relax
  \rk@listlinkcount=0\relax
  \def\rk@listhead{}\def\rk@listtail{}\def\rk@listfirst{}\def\rk@listlast{}%
}{%
  \ifnum\rk@listindex<1
    \PackageError{reportkit-algorithm-p3}{linkedliststate requires at least one listnode}{Declare one or more \string\listnode commands.}%
  \else
