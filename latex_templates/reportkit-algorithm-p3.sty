% ReportKit v1.10.0 -- P3 algorithm-state extensions
%
% Domain-specific algorithm views from section 15 of
% docs/superpowers/specs/2026-09-16-reportkit-algorithm-visualization-primitives-spec.md:
%   * joinstate       -- keyed/hash joins for data-engineering documents;
%   * unionfindstate  -- disjoint-set forests and union/find operations;
%   * linkedliststate -- singly linked-list traversal and mutation;
%   * recursiontree   -- recursive calls with arguments, return values, and
%                        memoization markers.
%
% This file is loaded by reportkit-algorithm-viz.sty after the shared state
% grammar and all P0--P2 layout styles have been defined.  It deliberately
% reuses `rk algo cell`, `rk algo graph node`, `rk algo graph edge`,
% `rk algo pointer`, and `rk algo container`: P3 adds semantic compositions,
% not a second palette or a coordinate-level drawing API.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-algorithm-p3}[2026/09/17 v1.0.0 ReportKit P3 algorithm extensions]
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds}
\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}

\makeatletter

\newcommand{\rk@pthree@unknownkey}[1]{%
  \PackageError{reportkit-algorithm-p3}{Unknown #1 key '\pgfkeyscurrentname'}%
    {Check the documented options for this algorithm-state primitive.}%
}
\newcommand{\rk@pthree@unknownid}[3]{%
  \PackageError{reportkit-algorithm-p3}{#1 references unknown node id '#2'}%
    {Declare '#2' before using it in \string#3.}%
}

% -----------------------------------------------------------------------------
% joinstate -- keyed/hash join state (spec section 15)
%
% The layout is intentionally a semantic three-stage composition:
% source relations on the left/right, a central hash/index, and matched output
% rows below it.  Authors declare records and keys; they never supply x/y
% coordinates.  `side=left|right` and `state=` are the only input semantics.
% -----------------------------------------------------------------------------
\newcount\rk@joinleftcount
\newcount\rk@joinrightcount
\newcount\rk@joinbucketcount
\newcount\rk@joinmatchcount
\newcount\rk@joinoutputcount
\newcommand{\rk@joininputstate}{}
\newcommand{\rk@joinbucketstate}{}
\newcommand{\rk@joinmatchstate}{}
\newcommand{\rk@joinoutputstate}{}
\newcommand{\rk@joinside}{left}
\newcommand{\rk@joinwidth}{12.4}
\newcommand{\rk@joinrowstep}{0.92}
\newcommand{\rk@joininputstep}{1.18}

\pgfkeys{
  /reportkit/joinstate/.is family,
  /reportkit/joinstate,
  width/.store in=\rk@joinwidth,
  row spacing/.store in=\rk@joinrowstep,
  input spacing/.store in=\rk@joininputstep,
  .unknown/.code={\rk@pthree@unknownkey{joinstate}}
}
\pgfkeys{
  /reportkit/joininput/.is family,
  /reportkit/joininput,
  side/.store in=\rk@joinside,
  state/.store in=\rk@joininputstate,
  .unknown/.code={\rk@pthree@unknownkey{joininput}}
}
\pgfkeys{
  /reportkit/joinbucket/.is family,
  /reportkit/joinbucket,
  state/.store in=\rk@joinbucketstate,
  .unknown/.code={\rk@pthree@unknownkey{hashbucket}}
}
\pgfkeys{
  /reportkit/joinmatch/.is family,
  /reportkit/joinmatch,
  state/.store in=\rk@joinmatchstate,
  .unknown/.code={\rk@pthree@unknownkey{joinmatch}}
}
\pgfkeys{
  /reportkit/joinoutput/.is family,
  /reportkit/joinoutput,
  state/.store in=\rk@joinoutputstate,
  .unknown/.code={\rk@pthree@unknownkey{joinoutput}}
}

% Internal input recorder.  #1 side, #2 label, #3 shared algorithm state.
\newcommand{\rk@joinaddinput}[3]{%
  \edef\rk@joinselectedside{#1}%
  \ifdefstring{\rk@joinselectedside}{left}{%
    \advance\rk@joinleftcount by 1\relax
    \expandafter\protected@edef\csname rk@join@input@left@label@\the\rk@joinleftcount\endcsname{#2}%
    \expandafter\edef\csname rk@join@input@left@state@\the\rk@joinleftcount\endcsname{#3}%
  }{\ifdefstring{\rk@joinselectedside}{right}{%
    \advance\rk@joinrightcount by 1\relax
    \expandafter\protected@edef\csname rk@join@input@right@label@\the\rk@joinrightcount\endcsname{#2}%
    \expandafter\edef\csname rk@join@input@right@state@\the\rk@joinrightcount\endcsname{#3}%
  }{%
    \PackageError{reportkit-algorithm-p3}{joininput side '#1' is invalid}%
      {Use side=left or side=right.}%
  }}%
}

% <reportkit-contract>
% {"kind":"figure","description":"Keyed join state with two input relations, a central hash/index structure, matched rows, and optional output rows.","arguments":[{"name":"options","type":"options","description":"width=, row spacing=, and input spacing= layout keys."}],"constraints":[{"code":"two_sides","description":"At least one left and one right input declaration are required."}],"example":"\\begin{diagram}[type=join,caption={Hash join.},description={Two input relations feed a central hash index; matching keys produce joined output rows.}]\n\\begin{joinstate}\n\\joininput[side=left]{orders}{Orders}\n\\joininput[side=right]{customers}{Customers}\n\\hashbucket[state=active]{customer_id}{C42,C73}\n\\joinmatch{customer_id}{C42 \\(\\to\\) joined row}\n\\joinoutput{Joined rows}\n\\end{joinstate}\n\\end{diagram}","stability":"experimental","since":"1.10.0"}
% </reportkit-contract>
\NewDocumentEnvironment{joinstate}{O{}}{%
  \begingroup
  \pgfkeys{/reportkit/joinstate,width=12.4,row spacing=.92,input spacing=1.18,#1}%
  \rk@joinleftcount=0\relax
  \rk@joinrightcount=0\relax
  \rk@joinbucketcount=0\relax
  \rk@joinmatchcount=0\relax
  \rk@joinoutputcount=0\relax
}{%
  \ifnum\rk@joinleftcount<1
    \PackageError{reportkit-algorithm-p3}{joinstate requires a left input}{Declare at least one \string\joininput[side=left]{id}{label}.}%
  \fi
  \ifnum\rk@joinrightcount<1
    \PackageError{reportkit-algorithm-p3}{joinstate requires a right input}{Declare at least one \string\joininput[side=right]{id}{label}.}%
  \fi
  \rk@joinrender
  \endgroup
}

% <reportkit-contract>
% {"kind":"command","description":"Declare one relation or stream feeding a keyed join from the left or right.","arguments":[{"name":"options","type":"options","description":"side=left|right and state= shared algorithm state."},{"name":"side","type":"text","description":"Input side; retained as a positional convenience when side= is omitted."},{"name":"label","type":"text","description":"Relation or stream label."}],"constraints":[{"code":"inside_joinstate","description":"Only valid inside joinstate."},{"code":"known_side","description":"side must be left or right."}],"example":"\\joininput[side=left,state=unseen]{orders}{Orders}","stability":"experimental","since":"1.10.0","parent":"joinstate"}
% </reportkit-contract>
\NewDocumentCommand{\joininput}{O{} m m}{%
  \pgfkeys{/reportkit/joininput,side=#2,state=unseen,#1}%
  \rk@joinaddinput{\rk@joinside}{#3}{\rk@joininputstate}%
}

% <reportkit-contract>
% {"kind":"command","description":"Declare a hash/index bucket with its join key and one or more indexed values.","arguments":[{"name":"options","type":"options","description":"state= shared algorithm state for the index bucket."},{"name":"key","type":"text","description":"Join key or key expression."},{"name":"values","type":"text","description":"Indexed values, usually comma-separated."}],"constraints":[{"code":"inside_joinstate","description":"Only valid inside joinstate."}],"example":"\\hashbucket[state=active]{customer_id}{C42,C73}","stability":"experimental","since":"1.10.0","parent":"joinstate"}
% </reportkit-contract>
\NewDocumentCommand{\hashbucket}{O{} m m}{%
  \pgfkeys{/reportkit/joinbucket,state=active,#1}%
  \advance\rk@joinbucketcount by 1\relax
  \expandafter\protected@edef\csname rk@join@bucket@key@\the\rk@joinbucketcount\endcsname{#2}%
  \expandafter\protected@edef\csname rk@join@bucket@values@\the\rk@joinbucketcount\endcsname{#3}%
  \expandafter\edef\csname rk@join@bucket@state@\the\rk@joinbucketcount\endcsname{\rk@joinbucketstate}%
}
\let\hashindex\hashbucket

% <reportkit-contract>
% {"kind":"command","description":"Declare one key match and the resulting joined row description.","arguments":[{"name":"options","type":"options","description":"state= shared algorithm state for the match; resolved is the default."},{"name":"key","type":"text","description":"Key matching a declared hashbucket."},{"name":"result","type":"text","description":"Joined-row description."}],"constraints":[{"code":"inside_joinstate","description":"Only valid inside joinstate."}],"example":"\\joinmatch{customer_id}{C42 \\(\\to\\) order/customer row}","stability":"experimental","since":"1.10.0","parent":"joinstate"}
% </reportkit-contract>
\NewDocumentCommand{\joinmatch}{O{} m m}{%
  \pgfkeys{/reportkit/joinmatch,state=resolved,#1}%
  \advance\rk@joinmatchcount by 1\relax
  \expandafter\protected@edef\csname rk@join@match@key@\the\rk@joinmatchcount\endcsname{#2}%
  \expandafter\protected@edef\csname rk@join@match@result@\the\rk@joinmatchcount\endcsname{#3}%
  \expandafter\edef\csname rk@join@match@state@\the\rk@joinmatchcount\endcsname{\rk@joinmatchstate}%
}
\let\joinpair\joinmatch

% <reportkit-contract>
% {"kind":"command","description":"Declare a key that did not produce a match on one side of the join.","arguments":[{"name":"options","type":"options","description":"state= shared algorithm state; discarded is the default."},{"name":"side","type":"text","description":"Input side, left or right."},{"name":"key","type":"text","description":"Unmatched key."}],"constraints":[{"code":"inside_joinstate","description":"Only valid inside joinstate."},{"code":"known_side","description":"side must be left or right."}],"example":"\\joinunmatched{right}{C99}","stability":"experimental","since":"1.10.0","parent":"joinstate"}
% </reportkit-contract>
\NewDocumentCommand{\joinunmatched}{O{} m m}{%
  \pgfkeys{/reportkit/joininput,side=#2,state=discarded,#1}%
  \rk@joinaddinput{\rk@joinside}{Unmatched key: #3}{\rk@joininputstate}%
}

% <reportkit-contract>
% {"kind":"command","description":"Declare a labelled output relation or result of the join.","arguments":[{"name":"options","type":"options","description":"state= shared algorithm state; resolved is the default."},{"name":"label","type":"text","description":"Output label."}],"constraints":[{"code":"inside_joinstate","description":"Only valid inside joinstate."}],"example":"\\joinoutput{Joined rows}","stability":"experimental","since":"1.10.0","parent":"joinstate"}
% </reportkit-contract>
\NewDocumentCommand{\joinoutput}{O{} m}{%
  \pgfkeys{/reportkit/joinoutput,state=resolved,#1}%
  \advance\rk@joinoutputcount by 1\relax
  \expandafter\protected@edef\csname rk@join@output@label@\the\rk@joinoutputcount\endcsname{#2}%
  \expandafter\edef\csname rk@join@output@state@\the\rk@joinoutputcount\endcsname{\rk@joinoutputstate}%
}
\let\joinresult\joinoutput

% The two side renderers keep input declaration order independent of which
% side was declared first.
\newcommand{\rk@joinrenderinputs}{%
  \ifnum\rk@joinleftcount>0
    \foreach \rk@i in {1,...,\the\rk@joinleftcount}{%
      \edef\rk@joinstate{\csname rk@join@input@left@state@\rk@i\endcsname}%
      \rk@setalgostate{\rk@joinstate}%
      \pgfmathsetmacro{\rk@joiny}{-(\rk@i-1)*\rk@joininputstep}%
      \node[rk algo graph node,\rk@algostateoverlay] (rk-join-input-left-\rk@i)
        at (0,\rk@joiny) {\strut \csname rk@join@input@left@label@\rk@i\endcsname};%
    }%
  \fi
  \ifnum\rk@joinrightcount>0
    \foreach \rk@i in {1,...,\the\rk@joinrightcount}{%
      \edef\rk@joinstate{\csname rk@join@input@right@state@\rk@i\endcsname}%
      \rk@setalgostate{\rk@joinstate}%
      \pgfmathsetmacro{\rk@joiny}{-(\rk@i-1)*\rk@joininputstep}%
      \node[rk algo graph node,\rk@algostateoverlay] (rk-join-input-right-\rk@i)
        at (\rk@joinwidth,\rk@joiny) {\strut \csname rk@join@input@right@label@\rk@i\endcsname};%
    }%
  \fi
}
\newcommand{\rk@joinrender}{%
  \rk@joinrenderinputs
  \node[rk algo graph node,rk algo state active,text width=31mm,minimum height=11mm]
    (rk-join-index) at ({0.5*\rk@joinwidth},0) {\strut HASH / INDEX};%
  \ifnum\rk@joinleftcount>0
    \foreach \rk@i in {1,...,\the\rk@joinleftcount}{%
      \draw[rk algo graph edge,dashed] (rk-join-input-left-\rk@i.east) -- (rk-join-index.west);%
    }%
  \fi
  \ifnum\rk@joinrightcount>0
    \foreach \rk@i in {1,...,\the\rk@joinrightcount}{%
      \draw[rk algo graph edge,dashed] (rk-join-input-right-\rk@i.west) -- (rk-join-index.east);%
    }%
  \fi
  \ifnum\rk@joinbucketcount>0
    \foreach \rk@i in {1,...,\the\rk@joinbucketcount}{%
      \edef\rk@joinstate{\csname rk@join@bucket@state@\rk@i\endcsname}%
      \rk@setalgostate{\rk@joinstate}%
      \pgfmathsetmacro{\rk@joiny}{-1.20-(\rk@i-1)*\rk@joinrowstep}%
      \node[rk algo cell,\rk@algostateoverlay,text width=31mm,minimum height=7mm]
        (rk-join-bucket-\rk@i) at ({0.5*\rk@joinwidth},\rk@joiny)
        {\strut \csname rk@join@bucket@key@\rk@i\endcsname:\ \csname rk@join@bucket@values@\rk@i\endcsname};%
    }%
  \fi
  \ifnum\rk@joinmatchcount>0
    \foreach \rk@j in {1,...,\the\rk@joinmatchcount}{%
      \edef\rk@joinstate{\csname rk@join@match@state@\rk@j\endcsname}%
      \rk@setalgostate{\rk@joinstate}%
      \pgfmathsetmacro{\rk@joiny}{-2.20-(\rk@joinbucketcount)*\rk@joinrowstep-(\rk@j-1)*\rk@joinrowstep}%
      \node[rk algo cell,\rk@algostateoverlay,text width=31mm,minimum height=7mm]
        (rk-join-match-\rk@j) at ({0.5*\rk@joinwidth},\rk@joiny)
        {\strut MATCH: \csname rk@join@match@key@\rk@j\endcsname\\\csname rk@join@match@result@\rk@j\endcsname};%
      \foreach \rk@i in {1,...,\the\rk@joinbucketcount}{%
        \edef\rk@joinbucketkey{\csname rk@join@bucket@key@\rk@i\endcsname}%
        \edef\rk@joinmatchkey{\csname rk@join@match@key@\rk@j\endcsname}%
        \ifdefstrequal{\rk@joinbucketkey}{\rk@joinmatchkey}{%
          \draw[rk algo graph edge] (rk-join-bucket-\rk@i.south) -- (rk-join-match-\rk@j.north);%
        }{}%
      }%
    }%
  \fi
  \ifnum\rk@joinoutputcount>0
    \foreach \rk@k in {1,...,\the\rk@joinoutputcount}{%
      \edef\rk@joinstate{\csname rk@join@output@state@\rk@k\endcsname}%
      \rk@setalgostate{\rk@joinstate}%
      \pgfmathsetmacro{\rk@joiny}{-2.55-(\rk@joinbucketcount+\rk@joinmatchcount)*\rk@joinrowstep-(\rk@k-1)*\rk@joinrowstep}%
      \node[rk algo graph node,\rk@algostateoverlay,text width=31mm,minimum height=8mm]
        (rk-join-output-\rk@k) at ({0.5*\rk@joinwidth},\rk@joiny)
        {\strut OUTPUT: \csname rk@join@output@label@\rk@k\endcsname};%
      \ifnum\rk@joinmatchcount>0
        \foreach \rk@j in {1,...,\the\rk@joinmatchcount}{%
          \draw[rk algo graph edge] (rk-join-match-\rk@j.south) -- (rk-join-output-\rk@k.north);%
        }%
      \fi
    }%
  \fi
}

