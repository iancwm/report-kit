\let\findoperation\findpath

\newcommand{\rk@ufrequireids}[3]{%
  \@ifundefined{rk@uf@x@#1}{\rk@pthree@unknownid{unionfindstate}{#1}{#3}}{}%
  \@ifundefined{rk@uf@x@#2}{\rk@pthree@unknownid{unionfindstate}{#2}{#3}}{}%
}
\newcommand{\rk@ufrenderedges}{%
  \ifnum\rk@ufparentcount>0
    \foreach \rk@i in {1,...,\the\rk@ufparentcount}{%
      \edef\rk@uflabel{\csname rk@uf@parent@label@\rk@i\endcsname}%
      \ifx\rk@uflabel\@empty
        \draw[rk algo graph edge] (\csname rk@uf@parent@child@\rk@i\endcsname) -- (\csname rk@uf@parent@parent@\rk@i\endcsname);%
      \else
        \draw[rk algo graph edge] (\csname rk@uf@parent@child@\rk@i\endcsname) -- node[rk edge label]{\rk@uflabel} (\csname rk@uf@parent@parent@\rk@i\endcsname);%
      \fi
    }%
  \fi
  \ifnum\rk@ufunioncount>0
    \foreach \rk@i in {1,...,\the\rk@ufunioncount}{%
      \draw[rk algo graph edge,dashed] (\csname rk@uf@union@left@\rk@i\endcsname) to[bend left=18]
        node[rk edge label]{\csname rk@uf@union@label@\rk@i\endcsname}
        (\csname rk@uf@union@right@\rk@i\endcsname);%
    }%
  \fi
  \ifnum\rk@uffindcount>0
    \foreach \rk@i in {1,...,\the\rk@uffindcount}{%
      \draw[rk algo pointer,dotted] (\csname rk@uf@find@from@\rk@i\endcsname) to[bend right=15]
        node[rk algo pointer label]{\csname rk@uf@find@label@\rk@i\endcsname}
        (\csname rk@uf@find@to@\rk@i\endcsname);%
    }%
  \fi
}

