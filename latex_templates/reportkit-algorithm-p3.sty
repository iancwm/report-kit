% <reportkit-contract>
% {"kind":"command","description":"Place one linked-list node in declaration order with an optional shared algorithm state.","arguments":[{"name":"options","type":"options","description":"state= one of the nine shared algorithm states."},{"name":"id","type":"text","description":"Node id referenced by nextlink, head, and tail."},{"name":"label","type":"text","description":"Node value or label."}],"constraints":[{"code":"inside_linkedliststate","description":"Only valid inside linkedliststate."}],"example":"\\listnode[state=current]{b}{B}","stability":"experimental","since":"1.10.0","parent":"linkedliststate"}
% </reportkit-contract>
\NewDocumentCommand{\listnode}{O{} m m}{%
  \@ifundefined{rk@list@x@#2}{%
    \pgfkeys{/reportkit/listnode,state={},#1}%
    \rk@setalgostate{\rk@listnodestate}%
    \pgfmathsetmacro{\rk@listx}{\the\rk@listindex*\rk@listspacing}%
    \pgfmathsetmacro{\rk@listy}{0}%
    \ifdefstring{\rk@listdirection}{vertical}{%
      \pgfmathsetmacro{\rk@listx}{0}%
      \pgfmathsetmacro{\rk@listy}{-\the\rk@listindex*\rk@listspacing}%
    }{}%
    \node[rk algo cell,\rk@algostateoverlay,text width=17mm,minimum height=8mm] (#2)
      at (\rk@listx,\rk@listy) {\strut #3};%
    \@namedef{rk@list@x@#2}{\rk@listx}%
    \@namedef{rk@list@y@#2}{\rk@listy}%
    \@namedef{rk@list@label@#2}{#3}%
    \ifnum\rk@listindex=0\relax\edef\rk@listfirst{#2}\fi
    \edef\rk@listlast{#2}%
    \advance\rk@listindex by 1\relax
  }{%
    \PackageError{reportkit-algorithm-p3}{Duplicate linked-list node id '#2'}{Use unique ids so next pointers are unambiguous.}%
  }%
}
\let\linkednode\listnode
\let\listitem\listnode

% <reportkit-contract>
% {"kind":"command","description":"Draw a labelled next pointer between two linked-list nodes.","arguments":[{"name":"options","type":"options","description":"Optional label= for the pointer."},{"name":"source","type":"text","description":"Source node id."},{"name":"target","type":"text","description":"Target node id."}],"constraints":[{"code":"inside_linkedliststate","description":"Only valid inside linkedliststate."},{"code":"known_node_ids","description":"Both ids must already be declared with listnode."}],"example":"\\nextlink{a}{b}","stability":"experimental","since":"1.10.0","parent":"linkedliststate"}
