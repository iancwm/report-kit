% <reportkit-contract>
% {"kind":"command","description":"Mark the head node of a linked list; an explicit HEAD label is rendered above or before it.","arguments":[{"name":"id","type":"text","description":"Head node id."}],"constraints":[{"code":"inside_linkedliststate","description":"Only valid inside linkedliststate."},{"code":"known_node_id","description":"id must be declared with listnode."}],"example":"\\head{a}","stability":"experimental","since":"1.10.0","parent":"linkedliststate"}
% </reportkit-contract>
\NewDocumentCommand{\head}{m}{%
