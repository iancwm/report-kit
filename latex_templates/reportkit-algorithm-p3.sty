% <reportkit-contract>
% {"kind":"figure","description":"Disjoint-set forest with automatic node layout, parent pointers, union operations, and find-path markers.","arguments":[{"name":"options","type":"options","description":"columns=, x spacing=, and y spacing= automatic layout keys."}],"constraints":[],"example":"\\begin{diagram}[type=union-find,caption={Union/find components.},description={Four nodes form two components; a parent pointer and a union operation join the components.}]\n\\begin{unionfindstate}\n\\ufnode{A}{A}\n\\ufnode{B}{B}\n\\ufnode{C}{C}\n\\ufnode[state=current]{D}{D}\n\\parent{B}{A}\n\\union{A}{C}\n\\findpath{D}{A}\n\\end{unionfindstate}\n\\end{diagram}","stability":"experimental","since":"1.10.0"}
% </reportkit-contract>
