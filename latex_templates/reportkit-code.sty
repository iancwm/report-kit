% ReportKit v1.2.0 -- code and output blocks
% v1.2.0: both space-reservation calls now go through the renderer hook
% \RKReserveSpace (see reportkit-core.sty/reportkit-paged-core.sty) instead
% of calling \Needspace directly. A3 (Phase A of the multi-format
% publication architecture spec) migrated every other semantic module to
% this hook but missed this file -- caught while preparing Phase B, since a
% slides core cannot implement \Needspace (there is no page flow inside a
% Beamer frame to reserve space in) and this module would have been the one
% thing still requiring needspace directly under \documentclass{reportkit-slides}.
% No fixture exercised codeblock/outputblock before this change (see the
% new coverage added to primitive_acceptance_test.tex), so there was no
% byte-hash baseline to preserve; the paged hook expands to exactly the
% \Needspace call it replaces, so paged output is unaffected by construction.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-code}[2026/09/13 v1.2.0 ReportKit code blocks]
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{xcolor}

\lstdefinestyle{reportkit}{%
  basicstyle=\ttfamily\fontsize{8.2}{10}\selectfont,
  keywordstyle=\color{LinkBlue}\bfseries,
  commentstyle=\color{Muted}\itshape,
  stringstyle=\color{Tip},
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  breakatwhitespace=false,
  tabsize=2,
  frame=none,
  xleftmargin=0pt,
  xrightmargin=0pt,
  aboveskip=0pt,
  belowskip=0pt
}

\newcommand{\rk@lstlang}[1]{%
  \def\rk@lang{#1}%
  \ifdefstring{\rk@lang}{Python}{Python}{%
  \ifdefstring{\rk@lang}{SQL}{SQL}{%
  \ifdefstring{\rk@lang}{HTML}{HTML}{}}}%
}

\NewTCBListing{codeblock}{O{} m}{%
  listing only,
  listing options={style=reportkit,language=#2},
  enhanced,breakable,colback=Surface,colframe=Hairline,boxrule=.45pt,
  arc=0pt,outer arc=0pt,left=7pt,right=7pt,top=8pt,bottom=7pt,
  before upper={\RKReserveSpace{8\baselineskip}},
  title={\sffamily\fontsize{7.1}{8.2}\selectfont\color{Muted}\IfNoValueTF{#1}{}{#1\hfill}\MakeUppercase{#2}},
  coltitle=Muted,fonttitle=\sffamily,
  attach boxed title to top left={xshift=0pt,yshift=-1pt},
  boxed title style={colback=Surface,colframe=Surface,boxrule=0pt,left=1pt,right=1pt,top=1pt,bottom=1pt},
  before skip=7pt,after skip=8pt
}

% <reportkit-contract>
% {"kind":"composition","description":"Outputblock","arguments":[],"constraints":[],"example":"\\begin{outputblock}\nExample content.\n\\end{outputblock}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{outputblock}{}{%
  \par\RKReserveSpace{6\baselineskip}%
  \begin{tcolorbox}[enhanced,breakable,colback=Surface,colframe=Hairline,boxrule=.45pt,
    arc=0pt,outer arc=0pt,left=8pt,right=8pt,top=7pt,bottom=7pt,
    title={\sffamily\fontsize{7.1}{8.2}\selectfont\bfseries\color{Muted}OUTPUT},
    coltitle=Muted,fontupper=\ttfamily\fontsize{8.2}{10}\selectfont,
    before skip=7pt,after skip=8pt]
}{\end{tcolorbox}}

\endinput
