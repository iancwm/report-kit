% ReportKit image slots for Markdown-driven publications.
% Image units are deliberately non-floating so they stay near their first
% manuscript reference. The renderer hooks provide the same page anchoring,
% caption numbering, and source treatment used by conceptual diagrams.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-images}[2026/09/24 v1.0.0 ReportKit image slots]
\RequirePackage{graphicx}
\RequirePackage{xparse}

\newlength{\rk@imageheight}
\newsavebox{\rk@imageunitbox}
\newcommand{\rk@imagesetheight}[1]{%
  \ifstrequal{#1}{wide}{\setlength{\rk@imageheight}{\dimexpr\linewidth*9/16\relax}}{%
  \ifstrequal{#1}{landscape}{\setlength{\rk@imageheight}{\dimexpr\linewidth*3/4\relax}}{%
  \ifstrequal{#1}{square}{\setlength{\rk@imageheight}{\linewidth}}{%
  \ifstrequal{#1}{portrait}{\setlength{\rk@imageheight}{\dimexpr\linewidth*4/3\relax}}{%
    \PackageError{reportkit-images}{Unknown image aspect ratio '#1'}%
      {Use wide, landscape, square, or portrait.}%
  }}}}%
}

\newcommand{\rk@imageplaceholder}[4]{%
  % #1 slug, #2 fixed frame height, #3 purpose, #4 exact replacement path.
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \noindent\fcolorbox{Muted}{white}{%
    \parbox[c][\dimexpr#2-2\fboxrule\relax][c]{\dimexpr\linewidth-2\fboxrule\relax}{%
      \centering\sffamily\color{Muted}%
      \textbf{IMAGE NEEDED: #1}\par
      \vspace{4pt}%
      #3\par
      \vspace{3pt}%
      {\footnotesize Replacement: \texttt{#4}}%
    }%
  }%
  \endgroup
}

% The alt argument is UTF-16BE uppercase hex generated by image_rendering.py.
% A hex PDF string avoids TeX escaping changing the stored accessibility text.
% This emits a zero-width ActualText span at the image's reading position.
% reportkit-contract: internal
\newcommand{\rk@imageactualtextmarker}[1]{%
  \ifPDFTeX
    \pdfliteral direct { /Span << /ActualText <FEFF#1> >> BDC }%
  \else
    \pdfextension literal direct { /Span << /ActualText <FEFF#1> >> BDC }%
  \fi
  \kern0pt%
  \ifPDFTeX
    \pdfliteral direct { EMC }%
  \else
    \pdfextension literal direct { EMC }%
  \fi
}

% Arguments: slug, purpose, caption, encoded alt text, aspect ratio, local
% path, source/credit line, and state ("supplied" or "placeholder").
% reportkit-contract: internal
\NewDocumentCommand{\rk@imageslot}{m m m m m m m m}{%
  \rk@imagesetheight{#5}%
  % Measure the complete image/caption/source unit once, then reserve exactly
  % that height before placing it. The saved vbox also prevents a caption or
  % source line from separating from its image at a page break.
  \par
  \setbox\rk@imageunitbox=\vbox{%
    \hsize=\linewidth
    \parindent=0pt
    \vspace{4pt}%
    \RKDiagramPlacementBegin
    \IfFileExists{#6}{%
      \includegraphics[width=\linewidth,height=\rk@imageheight,keepaspectratio]{#6}%
    }{%
      \rk@imageplaceholder{#1}{\rk@imageheight}{#2}{#6}%
    }%
    \rk@imageactualtextmarker{#4}%
    \RKDiagramPlacementEnd
    \vspace{-2pt}%
    \expandafter\ifstrempty\expandafter{#3}{}{\RKDiagramCaption{#3}}%
    \expandafter\ifstrempty\expandafter{#7}{}{\RKDiagramSource{#7}}%
    \par\vspace{5pt}%
  }%
  \RKReserveSpace{\dimexpr\ht\rk@imageunitbox+\dp\rk@imageunitbox\relax}%
  \noindent\usebox{\rk@imageunitbox}\par
}

\endinput
