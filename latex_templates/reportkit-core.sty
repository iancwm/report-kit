% ReportKit Core -- engine-neutral packages and structural mechanism shared by
% every theme and every renderer. Extracted from reportkit.cls v1.5.0 by the
% theme architecture in
% docs/superpowers/specs/2026-09-09-reportkit-institutional-theme-and-equity-profile-spec.md.
% Split again by the renderer architecture in
% docs/superpowers/specs/2026-09-09-reportkit-multi-format-publication-architecture-spec.md
% (Phase A3): paged-only mechanism -- geometry, fancyhdr, titlesec, needspace,
% caption, and everything semantic modules used to call directly for page
% break/placement/caption behavior -- moved to reportkit-paged-core.sty. A
% future slides core supplies the same renderer hooks with frame-based
% behavior. Visual identity -- typography, geometry, palette, running
% furniture, and title layout -- is theme-owned; see latex_templates/themes/.
% Nothing in this file may reference a theme color/length or a paged-only
% package: reportkit.cls loads this before it loads a renderer core or the
% selected theme.
%
% Phase A4 adds the style token contract below: the theme-owned values a
% semantic module (reportkit-boxes.sty today) reads instead of branching on
% \rk@theme. Mechanism only, same rule as the renderer hooks above -- no
% visual value is defined here, only the sentinel that fires if a theme
% forgot to populate one.
%
% hyperref is deliberately NOT required here even though this file owns
% hyperref's *setup* (the metadata/catalog-language block below, and RKLink).
% hyperref's own documentation asks to be loaded after other formatting
% packages -- notably geometry -- and geometry is paged-only (a slides core
% will size its canvas differently). Requiring hyperref from a renderer core,
% right after that renderer's page/canvas package, keeps that contract true
% for every renderer while this file keeps owning what hyperref is
% configured to do. Verified empirically: requiring hyperref here instead
% (before geometry) changes computed named-destination coordinates and
% breaks the pinned default-theme PDF hash even though nothing else changed.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-core}[2026/09/13 v1.9.0 ReportKit engine-neutral core]

\RequirePackage{iftex}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{siunitx}
\RequirePackage{enumitem}
\RequirePackage{xparse}
\RequirePackage{etoolbox}

% <reportkit-contract>
% {"kind":"command","description":"Render a safe named link from links.yaml.","arguments":[{"name":"key","type":"link-key","description":"Registered link key."}],"constraints":[{"code":"known_link","description":"Use a key declared in links.yaml; unknown values fall back to literal URLs."}],"example":"\\RKLink{project-home}","stability":"stable","since":"1.5.0"}
% </reportkit-contract>
\ProvideDocumentCommand{\RKLink}{m}{\href{#1}{#1}}

% -----------------------------------------------------------------------------
% Metadata and running furniture (mechanism; visual values live in the theme)
% -----------------------------------------------------------------------------
\newcommand{\rk@leftheader}{REPORTKIT}
\newcommand{\rk@footer}{Technical report}
\newcommand{\rk@version}{v1.0}
\newcommand{\rk@subject}{Technical report}
\newcommand{\rk@keywords}{ReportKit, technical report}
\newcommand{\rk@language}{en-US}
\newcommand{\setreportkitleftheader}[1]{\renewcommand{\rk@leftheader}{#1}}
\newcommand{\setreportkitfooter}[1]{\renewcommand{\rk@footer}{#1}}
\newcommand{\setreportkitversion}[1]{\renewcommand{\rk@version}{#1}}
\newcommand{\setreportkitsubject}[1]{\renewcommand{\rk@subject}{#1}}
\newcommand{\setreportkitkeywords}[1]{\renewcommand{\rk@keywords}{#1}}
\newcommand{\setreportkitlanguage}[1]{\renewcommand{\rk@language}{#1}}

% Keep PDF metadata coupled to the document's normal title and author fields.
% hyperref performs the necessary PDF-string sanitisation for bookmarks and
% metadata, so callers can continue using ordinary LaTeX in \title/\author.
%
% This is defined here (what to do) but scheduled with \AtBeginDocument by
% the renderer core (when to do it; see reportkit-paged-core.sty), not here.
% hyperref itself registers an \AtBeginDocument hook when it loads (for
% /PageMode, /ViewerPreferences, ...), and \AtBeginDocument hooks run in
% registration order: registering this one before a renderer core has
% required hyperref put it ahead of hyperref's own hook and produced a
% different /Catalog key order in the pinned default-theme PDF than before
% this file existed, even though the visible document was unchanged.
% Requiring hyperref right before scheduling this (both in the renderer
% core, mirroring the original single-file load order exactly) reproduces
% the pinned hash.
\newcommand{\RKRegisterDocumentMetadata}{%
  \hypersetup{
    pdftitle={\@title},
    pdfauthor={\@author},
    pdfsubject={\rk@subject},
    pdfkeywords={\rk@keywords},
    pdfdisplaydoctitle=true
  }%
  % Write the catalog language directly; pdflang support varies by hyperref
  % engine, while the PDF catalog requirement is stable.
  \ifPDFTeX
    \pdfcatalog{/Lang (\rk@language)}%
  \else
    \pdfextension catalog {/Lang (\rk@language)}%
  \fi
}

% -----------------------------------------------------------------------------
% Renderer hooks (mechanism only -- no visual behavior lives here)
% -----------------------------------------------------------------------------
% Every renderer core (reportkit-paged-core.sty today; a slides core in a
% later phase) must define each hook below before any theme or semantic
% module loads. Semantic modules call only these names, never a paged-only
% package directly, so the same callout/code/diagram/section source compiles
% under any renderer. Left here as loud sentinels: if a renderer core is
% missing or a semantic module is loaded out of order, authoring fails
% immediately instead of silently reserving no space or emitting no caption.
\newcommand{\rk@rendererhookerror}[1]{%
  \PackageError{reportkit-core}{No renderer core has defined \string#1}%
    {Load a renderer core (e.g. reportkit-paged-core) right after reportkit-core, before any theme or semantic module.}%
}
% Renderer-implementation mechanism, not an authoring primitive -- no
% <reportkit-contract> block, same as \Needspace itself never had one.
\newcommand{\RKReserveSpace}[1]{\rk@rendererhookerror{\RKReserveSpace}}
\newcommand{\RKDiagramPlacementBegin}{\rk@rendererhookerror{\RKDiagramPlacementBegin}}
\newcommand{\RKDiagramPlacementEnd}{\rk@rendererhookerror{\RKDiagramPlacementEnd}}
\newcommand{\RKDiagramCaption}[1]{\rk@rendererhookerror{\RKDiagramCaption}}
\newcommand{\RKDiagramSource}[1]{\rk@rendererhookerror{\RKDiagramSource}}
\newif\ifrk@rendererhooksloaded
\rk@rendererhooksloadedfalse
% Called by reportkit.cls (or a future slides class) immediately after its
% renderer core loads, before any theme or semantic module.
\newcommand{\RKAssertRendererHooks}{%
  \ifrk@rendererhooksloaded\else
    \PackageError{reportkit-core}{No renderer core was loaded}%
      {Load a renderer core (e.g. reportkit-paged-core) right after reportkit-core.}%
  \fi
}

% -----------------------------------------------------------------------------
% Style token contract (mechanism only -- no visual value lives here)
% -----------------------------------------------------------------------------
% Phase A4 of the multi-format publication architecture spec (decision D2)
% moves component appearance behind theme-owned tokens instead of a semantic
% module branching on \rk@theme. The selected theme's common package (loaded
% right after this file, before any semantic module) must renew every token
% below and then set \rk@styletokensloadedtrue. Left here as loud sentinels,
% the same pattern as the renderer hooks above: calling an unset token fails
% immediately with a clear diagnostic instead of silently falling back to
% some other theme's appearance.
\newcommand{\rk@styletokenerror}[1]{%
  \PackageError{reportkit-core}{No theme has defined \string#1}%
    {Load a theme package (e.g. reportkit-theme-default) before any semantic module.}%
}
% Callout chrome (reportkit-boxes.sty's principle/decisionpoint/redflag/...).
% Category colors (Principle, Decision, RedFlag, ...) are separate,
% pre-existing named colors -- these tokens style the box itself.
\newcommand{\RKTokCalloutColBack}{\rk@styletokenerror{\RKTokCalloutColBack}}
\newcommand{\RKTokCalloutColFrame}{\rk@styletokenerror{\RKTokCalloutColFrame}}
\newcommand{\RKTokCalloutBoxRule}{\rk@styletokenerror{\RKTokCalloutBoxRule}}
\newcommand{\RKTokCalloutLeftRule}{\rk@styletokenerror{\RKTokCalloutLeftRule}}
\newcommand{\RKTokCalloutArc}{\rk@styletokenerror{\RKTokCalloutArc}}
\newcommand{\RKTokCalloutOuterArc}{\rk@styletokenerror{\RKTokCalloutOuterArc}}
\newcommand{\RKTokCalloutPadLeft}{\rk@styletokenerror{\RKTokCalloutPadLeft}}
\newcommand{\RKTokCalloutPadRight}{\rk@styletokenerror{\RKTokCalloutPadRight}}
\newcommand{\RKTokCalloutPadTop}{\rk@styletokenerror{\RKTokCalloutPadTop}}
\newcommand{\RKTokCalloutPadBottom}{\rk@styletokenerror{\RKTokCalloutPadBottom}}
\newcommand{\RKTokCalloutBeforeSkip}{\rk@styletokenerror{\RKTokCalloutBeforeSkip}}
\newcommand{\RKTokCalloutAfterSkip}{\rk@styletokenerror{\RKTokCalloutAfterSkip}}
% A theme's font-role tokens are executed as ordinary TeX code (they sit
% inside a tcolorbox title's token list, typeset when the box renders, not
% parsed as a pgfkeys value), so each bundles its own \fontsize{}{}\selectfont
% -- callers never guess a leading independently of its size.
\newcommand{\RKTokCalloutTitleFont}{\rk@styletokenerror{\RKTokCalloutTitleFont}}
% Metric card (reportkit-boxes.sty's \metric environment).
\newcommand{\RKTokMetricColBack}{\rk@styletokenerror{\RKTokMetricColBack}}
\newcommand{\RKTokMetricColFrame}{\rk@styletokenerror{\RKTokMetricColFrame}}
\newcommand{\RKTokMetricBoxRule}{\rk@styletokenerror{\RKTokMetricBoxRule}}
\newcommand{\RKTokMetricArc}{\rk@styletokenerror{\RKTokMetricArc}}
\newcommand{\RKTokMetricOuterArc}{\rk@styletokenerror{\RKTokMetricOuterArc}}
\newcommand{\RKTokMetricPadLeft}{\rk@styletokenerror{\RKTokMetricPadLeft}}
\newcommand{\RKTokMetricPadRight}{\rk@styletokenerror{\RKTokMetricPadRight}}
\newcommand{\RKTokMetricPadTop}{\rk@styletokenerror{\RKTokMetricPadTop}}
\newcommand{\RKTokMetricPadBottom}{\rk@styletokenerror{\RKTokMetricPadBottom}}
\newcommand{\RKTokMetricBeforeSkip}{\rk@styletokenerror{\RKTokMetricBeforeSkip}}
\newcommand{\RKTokMetricAfterSkip}{\rk@styletokenerror{\RKTokMetricAfterSkip}}
\newcommand{\RKTokMetricBorderLineWidth}{\rk@styletokenerror{\RKTokMetricBorderLineWidth}}
\newcommand{\RKTokMetricLabelFont}{\rk@styletokenerror{\RKTokMetricLabelFont}}
\newcommand{\RKTokMetricValueFont}{\rk@styletokenerror{\RKTokMetricValueFont}}
\newcommand{\RKTokMetricSubtitleFont}{\rk@styletokenerror{\RKTokMetricSubtitleFont}}
\newcommand{\RKTokMetricSubtitleSpacing}{\rk@styletokenerror{\RKTokMetricSubtitleSpacing}}
\newcommand{\RKTokMetricWhyFont}{\rk@styletokenerror{\RKTokMetricWhyFont}}
\newif\ifrk@styletokensloaded
\rk@styletokensloadedfalse
% Called by reportkit-boxes.sty (or any future style-token consumer)
% immediately before defining anything that reads a token above.
\newcommand{\RKAssertStyleTokens}{%
  \ifrk@styletokensloaded\else
    \PackageError{reportkit-core}{No theme has populated the required style tokens}%
      {Load a theme package (e.g. reportkit-theme-default) before any semantic module.}%
  \fi
}

% -----------------------------------------------------------------------------
% Presentation-composition style tokens (Phase B, decision D2 extended to the
% slides renderer)
% -----------------------------------------------------------------------------
% A separate contract and assertion gate from the callout/metric tokens
% above, not folded into \RKAssertStyleTokens/\ifrk@styletokensloaded: these
% tokens are only ever read by reportkit-presentation.sty (loaded only when
% publication-type=presentation, which only ever pairs with a slides-only
% theme). Sharing one gate would force every paged theme (default,
% institutional-research, neither of which ever loads
% reportkit-presentation.sty) to populate slide-only tokens just to keep
% passing reportkit-boxes.sty's assertion. Populated by a slides-compatible
% theme's -slides adapter package (renderer-specific, like paged's geometry
% and running furniture -- not the common package), since composition
% spacing/type is exactly the kind of per-renderer component value D11
% assigns to the adapter layer. Font-role tokens bundle their own
% \fontsize{}{}\selectfont for the same reason the callout/metric ones do
% (executed as ordinary TeX, not parsed as a pgfkeys value). Colors are not
% tokenized here: every slides-compatible theme's common package is expected
% to define the same semantic color names paged themes already do (Ink,
% Muted, Hairline, Surface) plus Accent, and reportkit-presentation.sty
% refers to those names directly -- the same pattern reportkit-boxes.sty
% already uses for category colors.
\newcommand{\RKTokPresentationKickerFont}{\rk@styletokenerror{\RKTokPresentationKickerFont}}
\newcommand{\RKTokPresentationTitleFont}{\rk@styletokenerror{\RKTokPresentationTitleFont}}
\newcommand{\RKTokPresentationSubtitleFont}{\rk@styletokenerror{\RKTokPresentationSubtitleFont}}
\newcommand{\RKTokPresentationDividerTitleFont}{\rk@styletokenerror{\RKTokPresentationDividerTitleFont}}
\newcommand{\RKTokPresentationMessageFont}{\rk@styletokenerror{\RKTokPresentationMessageFont}}
\newcommand{\RKTokPresentationBodyFont}{\rk@styletokenerror{\RKTokPresentationBodyFont}}
\newcommand{\RKTokPresentationCaptionFont}{\rk@styletokenerror{\RKTokPresentationCaptionFont}}
\newcommand{\RKTokPresentationHeroValueFont}{\rk@styletokenerror{\RKTokPresentationHeroValueFont}}
\newcommand{\RKTokPresentationHeroLabelFont}{\rk@styletokenerror{\RKTokPresentationHeroLabelFont}}
\newcommand{\RKTokPresentationColumnHeadingFont}{\rk@styletokenerror{\RKTokPresentationColumnHeadingFont}}
\newcommand{\RKTokPresentationClosingFont}{\rk@styletokenerror{\RKTokPresentationClosingFont}}
\newcommand{\RKTokPresentationRuleWidth}{\rk@styletokenerror{\RKTokPresentationRuleWidth}}
\newif\ifrk@presentationtokensloaded
\rk@presentationtokensloadedfalse
% Called by reportkit-presentation.sty immediately before defining anything
% that reads a token above.
\newcommand{\RKAssertPresentationTokens}{%
  \ifrk@presentationtokensloaded\else
    \PackageError{reportkit-core}{No theme has populated the required presentation style tokens}%
      {Load a slides-compatible theme's adapter (e.g. reportkit-theme-executive-slides) before reportkit-presentation.}%
  \fi
}

% -----------------------------------------------------------------------------
% Anti-stranding page-break mechanism (structural, not visual -- every theme
% shares the same heuristic fractions of \textheight)
% -----------------------------------------------------------------------------
% Use this when a section opens with a conceptual diagram after a short setup
% paragraph. It reserves the whole reading unit: heading + setup + compact
% diagram/caption. If insufficient space remains, the section starts next page.
% <reportkit-contract>
% {"kind":"command","description":"Rkdiagramsection","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\RKDiagramSection{Example}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentCommand{\RKDiagramSection}{m}{%
  \par\RKReserveSpace{0.46\textheight}%
  \section{#1}%
}

% Smaller variant for a subsection that opens with a diagram.
% <reportkit-contract>
% {"kind":"command","description":"Rkdiagramsubsection","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\RKDiagramSubsection{Example}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentCommand{\RKDiagramSubsection}{m}{%
  \par\RKReserveSpace{0.38\textheight}%
  \subsection{#1}%
}

% Inline code helper; full code blocks live in reportkit-code.sty.
\newcommand{\code}[1]{\texttt{#1}}

