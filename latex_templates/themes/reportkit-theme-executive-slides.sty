% ReportKit theme adapter: executive / slides renderer. Stable Phase C
% consulting/strategy frame geometry and presentation token scale.
%
% Owns this theme's canvas/frame geometry, running chrome (footline), and
% the presentation-composition style tokens reportkit-presentation.sty
% reads (reportkit-core.sty's "Presentation-composition style tokens"
% section) -- the slides-renderer counterpart of what a -paged adapter owns
% (geometry, running furniture, section-heading placement). Composition
% spacing/type is a per-renderer component value under D11 exactly like
% paged section-heading placement is, so it lives here, not in the common
% theme file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-executive-slides}[2026/09/20 v1.0.0 ReportKit executive theme / slides adapter]

% -----------------------------------------------------------------------------
% Canvas and safe margin
% -----------------------------------------------------------------------------
% The 160mm x 90mm frame itself comes from reportkit-slides.cls's
% \LoadClass[aspectratio=169]{beamer} (see that file's header). This adapter
% only sets the safe-area text margin inside that frame -- 8mm each side,
% 144mm usable width. python_scripts/reportkit/themes/executive.py's B3
% slide-slot widths are derived from this same 144mm figure; if this number
% changes, that file's comment says to update it too (no cross-language
% token sync mechanism exists yet, the same gap that already exists for
% every paged theme's \geometry{} margins versus reportkit_viz.py's
% TEXT_WIDTH_IN).
\setbeamersize{text margin left=8mm,text margin right=8mm}

% -----------------------------------------------------------------------------
% Running chrome -- minimal footline (page number, version). No headline:
% compositions carry their own heading typography (B2: reportkit-presentation
% owns structure, not Beamer's frametitle chrome), so \setbeamertemplate is
% left untouched for frametitle/headline; nothing in this theme calls
% \frametitle.
% -----------------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox{\begin{beamercolorbox}[wd=\paperwidth,ht=2.8mm,dp=1.2mm,leftskip=8mm,rightskip=8mm]{}
    {\sffamily\RKTokPresentationSourceFont\color{Muted}\rk@footer\ \textperiodcentered\ \rk@version\hfill\insertframenumber}
  \end{beamercolorbox}}
}

% -----------------------------------------------------------------------------
% Presentation-composition style tokens (reportkit-core.sty's contract).
% The scale gives short claims visual priority while keeping charts, tables,
% and diagrams readable at the declared 160 x 90 mm canvas.
% -----------------------------------------------------------------------------
\renewcommand{\RKTokPresentationKickerFont}{\fontsize{8.5pt}{10.5pt}\selectfont}
\renewcommand{\RKTokPresentationTitleFont}{\fontsize{29pt}{33pt}\selectfont}
\renewcommand{\RKTokPresentationSubtitleFont}{\fontsize{12pt}{15pt}\selectfont}
\renewcommand{\RKTokPresentationDividerTitleFont}{\fontsize{35pt}{39pt}\selectfont}
\renewcommand{\RKTokPresentationMessageFont}{\fontsize{23pt}{27pt}\selectfont}
% Standard working-slide assertions are intentionally smaller than the
% hero-message role above. The header envelope is a bounded composition
% contract, not a continuous responsive type scale.
\renewcommand{\RKTokPresentationAssertionFont}{\fontsize{18.5pt}{22pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionCompactFont}{\fontsize{16.5pt}{20pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionDeckFont}{\fontsize{10pt}{12pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionHeaderMaxHeight}{24mm}
\renewcommand{\RKTokPresentationDenseBodyFont}{\fontsize{10pt}{12pt}\selectfont}
\renewcommand{\RKTokPresentationAnnotationFont}{\fontsize{8pt}{9.5pt}\selectfont}
\renewcommand{\RKTokPresentationSourceFont}{\fontsize{6.8pt}{8.2pt}\selectfont}
\renewcommand{\RKTokPresentationCardGutter}{4mm}
\renewcommand{\RKTokPresentationCardPadding}{3.5mm}
\renewcommand{\RKTokPresentationCardMinHeight}{22mm}
\renewcommand{\RKTokPresentationProseWidth}{110mm}
\renewcommand{\RKTokPresentationBodyFont}{\fontsize{11.5pt}{15pt}\selectfont}
\renewcommand{\RKTokPresentationCaptionFont}{\fontsize{7.5pt}{9pt}\selectfont}
\renewcommand{\RKTokPresentationHeroValueFont}{\fontsize{54pt}{58pt}\selectfont}
\renewcommand{\RKTokPresentationHeroLabelFont}{\fontsize{11pt}{14pt}\selectfont}
\renewcommand{\RKTokPresentationColumnHeadingFont}{\fontsize{12.5pt}{15pt}\selectfont}
\renewcommand{\RKTokPresentationClosingFont}{\fontsize{25pt}{29pt}\selectfont}
\renewcommand{\RKTokPresentationRuleWidth}{.85pt}
\rk@presentationtokensloadedtrue

\endinput
