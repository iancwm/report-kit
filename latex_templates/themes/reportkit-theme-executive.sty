% ReportKit theme: executive -- the stable consulting/strategy visual system
% for the slides renderer. Phase C of the multi-format publication
% architecture spec (decisions D8, D9) establishes the assertion-evidence
% hierarchy, restrained palette, grid, and moderate-high information density.
% The presentation composition API remains renderer/theme neutral; this file
% owns the semantic appearance that the executive slide adapter consumes.
%
% Owns fonts, palette, and renderer-neutral semantic appearance -- the same
% split A4/D11 established for default and institutional-research (compare
% reportkit-theme-default.sty's own header comment). Geometry, running
% furniture, and other slides-specific values live in
% reportkit-theme-executive-slides.sty, this theme's only registered adapter.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-executive}[2026/09/20 v1.0.0 ReportKit executive theme]

% -----------------------------------------------------------------------------
% Engine guard (decision D9: new visual themes require LuaLaTeX)
% -----------------------------------------------------------------------------
% Same defense-in-depth pattern reportkit-theme-institutional-research.sty
% uses: config.py's theme_engine_conflict() already refuses to build this
% theme under any other engine before a compiler runs; this is the same rule
% enforced a second time at the TeX level.
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{reportkit-theme-executive}%
    {The executive theme requires LuaLaTeX}%
    {Compile with lualatex, or set document.engine: lualatex in publication.yaml.}
\fi

% -----------------------------------------------------------------------------
% Fonts -- the bundled Libertinus Sans family gives direct fixtures and
% pipeline builds a reproducible, open sans face without requiring a consumer
% project to ship a separate brand font. The chart theme mirrors this choice.
% -----------------------------------------------------------------------------
\RequirePackage{libertinus}

% -----------------------------------------------------------------------------
% Palette. A restrained navy/teal system with one warm decision accent. The
% roles are intentionally semantic: positive/negative arithmetic, evidence,
% decision, and limitation remain legible in colour and in grayscale.
% -----------------------------------------------------------------------------
\definecolor{Ink}{HTML}{17202A}
\definecolor{Muted}{HTML}{566273}
\definecolor{Hairline}{HTML}{D8DEE7}
\definecolor{Surface}{HTML}{F2F5F8}
\definecolor{Accent}{HTML}{0B7285}
\definecolor{LinkBlue}{HTML}{0B7285}
% Semantic callout/metric category colors reportkit-boxes.sty expects every
% theme to provide (see reportkit-theme-default.sty's palette block).
\definecolor{Principle}{HTML}{0B7285}
\definecolor{Decision}{HTML}{C26A2D}
\definecolor{Research}{HTML}{3C6E71}
\definecolor{Tip}{HTML}{2F855A}
\definecolor{RedFlag}{HTML}{B54747}
\definecolor{Assumption}{HTML}{9A6B1E}
