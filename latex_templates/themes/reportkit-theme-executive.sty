% ReportKit theme: executive -- EXPERIMENTAL shell, Phase B of the
% multi-format publication architecture spec (decisions D8, D9). "Do not
% release between B and C" (D8): this file exists so the slides renderer and
% presentation composition API (reportkit-presentation.sty) have a real
% theme to compile against, not to be a finished visual design. Phase C
% ("Executive theme") tunes the actual assertion-evidence hierarchy, grid,
% density, and chart/table/diagram styles per the renderer spec, and
% promotes this theme from experimental to stable only after visual review
% (see publications.py's THEMES["executive"] stability field).
%
% Owns fonts, palette, and renderer-neutral semantic appearance -- the same
% split A4/D11 established for default and institutional-research (compare
% reportkit-theme-default.sty's own header comment). Geometry, running
% furniture, and other slides-specific values live in
% reportkit-theme-executive-slides.sty, this theme's only adapter so far
% (Phase C may add reportkit-theme-executive-paged.sty; D11's two-layer load
% means that would not require changing this file).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-executive}[2026/09/13 v0.1.0 ReportKit executive theme (experimental)]

% -----------------------------------------------------------------------------
% Engine guard (decision D9: new visual themes require LuaLaTeX)
% -----------------------------------------------------------------------------
% Same defense-in-depth pattern reportkit-theme-institutional-research.sty
% uses: config.py's theme_engine_conflict() already refuses to build this
% theme under any other engine before a compiler runs; this is the same rule
% enforced a second time at the TeX level.
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{reportkit-theme-executive}%
    {The executive theme requires LuaLaTeX}%
    {Compile with lualatex, or set document.engine: lualatex in publication.yaml.}
\fi

% -----------------------------------------------------------------------------
% Fonts -- reuses the bundled Libertinus assets already staged for the
% default/longform fixtures (font_data/reportkit-libertinus-fonts.tar.gz via
% the toolchain, or ambient system fonts). D9 recommends Google Sans (already
% bundled for institutional-research) for executive/venture; this shell uses
% Libertinus instead, deliberately, because it needs no font_path/font_policy
% plumbing to compile in any LuaLaTeX environment this repository already
% supports, and this file's own header says explicitly not to treat its
% visual choices as final. Phase C's design review picks the real family.
% -----------------------------------------------------------------------------
\RequirePackage{libertinus}

% -----------------------------------------------------------------------------
% Palette. Distinct hex values from both existing themes' palettes (not
% reused, not tuned -- placeholders a design review replaces in Phase C).
% Accent is this theme's required semantic role for
% reportkit-presentation.sty's kicker/label color, the same role name
% reportkit-theme-institutional-research.sty already established.
% -----------------------------------------------------------------------------
\definecolor{Ink}{HTML}{1B1E24}
\definecolor{Muted}{HTML}{5B6270}
\definecolor{Hairline}{HTML}{D5D8DE}
\definecolor{Surface}{HTML}{F5F6F8}
\definecolor{Accent}{HTML}{3B5BDB}
\definecolor{LinkBlue}{HTML}{3B5BDB}
% Semantic callout/metric category colors reportkit-boxes.sty expects every
% theme to provide (see reportkit-theme-default.sty's palette block).
\definecolor{Principle}{HTML}{3B5BDB}
\definecolor{Decision}{HTML}{7048A8}
\definecolor{Research}{HTML}{1D8A7A}
\definecolor{Tip}{HTML}{2F7D4F}
\definecolor{RedFlag}{HTML}{B23A3A}
\definecolor{Assumption}{HTML}{9A6B1E}
\definecolor{Evidence}{HTML}{3F5D75}
\definecolor{Limitation}{HTML}{6B6560}
\definecolor{Deliverable}{HTML}{22694A}
\definecolor{MetricAccent}{HTML}{3B5BDB}

\color{Ink}
\hypersetup{colorlinks=true,linkcolor=LinkBlue,urlcolor=LinkBlue,citecolor=LinkBlue,pdfborder={0 0 0},pdfdisplaydoctitle=true}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt plus 1pt minus .5pt}
\setlist{nosep,leftmargin=1.4em,topsep=3pt}
\sisetup{detect-all=true,group-separator={,}}

% -----------------------------------------------------------------------------
% Style tokens (reportkit-core.sty's callout/metric contract) -- reuses the
% default theme's exact chrome values. Not restyled for slides specifically:
% callouts/metric cards are a secondary primitive on a slide (most content
% goes through reportkit-presentation.sty's own compositions), so there is
% no design reason yet to diverge, and Phase C can retune this without
% touching reportkit-boxes.sty.
% -----------------------------------------------------------------------------
\renewcommand{\RKTokCalloutColBack}{Surface}
\renewcommand{\RKTokCalloutColFrame}{Hairline}
\renewcommand{\RKTokCalloutBoxRule}{.45pt}
\renewcommand{\RKTokCalloutLeftRule}{2.2pt}
\renewcommand{\RKTokCalloutArc}{0pt}
\renewcommand{\RKTokCalloutOuterArc}{0pt}
\renewcommand{\RKTokCalloutPadLeft}{8pt}
\renewcommand{\RKTokCalloutPadRight}{8pt}
\renewcommand{\RKTokCalloutPadTop}{6pt}
\renewcommand{\RKTokCalloutPadBottom}{6pt}
\renewcommand{\RKTokCalloutBeforeSkip}{6pt}
\renewcommand{\RKTokCalloutAfterSkip}{7pt}
\renewcommand{\RKTokCalloutTitleFont}{\fontsize{7.3}{8.5}\selectfont}
\renewcommand{\RKTokMetricColBack}{white}
\renewcommand{\RKTokMetricColFrame}{Hairline}
\renewcommand{\RKTokMetricBoxRule}{.45pt}
\renewcommand{\RKTokMetricArc}{0pt}
\renewcommand{\RKTokMetricOuterArc}{0pt}
\renewcommand{\RKTokMetricPadLeft}{10pt}
\renewcommand{\RKTokMetricPadRight}{10pt}
\renewcommand{\RKTokMetricPadTop}{8pt}
\renewcommand{\RKTokMetricPadBottom}{8pt}
\renewcommand{\RKTokMetricBeforeSkip}{7pt}
\renewcommand{\RKTokMetricAfterSkip}{8pt}
\renewcommand{\RKTokMetricBorderLineWidth}{2.4pt}
\renewcommand{\RKTokMetricLabelFont}{\fontsize{7.3}{8.5}\selectfont}
\renewcommand{\RKTokMetricValueFont}{\fontsize{21}{23}\selectfont}
\renewcommand{\RKTokMetricSubtitleFont}{\fontsize{8.3}{10}\selectfont}
\renewcommand{\RKTokMetricSubtitleSpacing}{4pt}
\renewcommand{\RKTokMetricWhyFont}{\fontsize{7.2}{8.4}\selectfont}
\rk@styletokensloadedtrue

% Figure/table provenance helper (reportkit-core.sty's contract; every theme
% defines this). Reused as-is under Beamer -- \RKDiagramSource calls it
% unchanged (reportkit-slides-core.sty).
\newcommand{\source}[1]{\par\vspace{1pt}{\sffamily\fontsize{6.6pt}{8pt}\selectfont\color{Muted}\textit{Source:} #1}\par}

\endinput
