% Large display type and generous spacing: a pitch slide carries one idea.
% Display roles use the brand display face when one is configured.
% -----------------------------------------------------------------------------
\renewcommand{\RKTokPresentationKickerFont}{\fontsize{9pt}{11pt}\selectfont}
\renewcommand{\RKTokPresentationTitleFont}{\rkventure@displayface\fontsize{36pt}{39pt}\selectfont}
\renewcommand{\RKTokPresentationSubtitleFont}{\fontsize{14pt}{18pt}\selectfont}
\renewcommand{\RKTokPresentationDividerTitleFont}{\rkventure@displayface\fontsize{40pt}{43pt}\selectfont}
\renewcommand{\RKTokPresentationMessageFont}{\rkventure@displayface\fontsize{25pt}{28.5pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionFont}{\rkventure@displayface\fontsize{22pt}{25.5pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionCompactFont}{\rkventure@displayface\fontsize{19pt}{22.5pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionDeckFont}{\fontsize{11pt}{13.5pt}\selectfont}
\renewcommand{\RKTokPresentationAssertionHeaderMaxHeight}{27mm}
\renewcommand{\RKTokPresentationDenseBodyFont}{\fontsize{10.5pt}{13pt}\selectfont}
\renewcommand{\RKTokPresentationAnnotationFont}{\fontsize{9pt}{11pt}\selectfont}
\renewcommand{\RKTokPresentationSourceFont}{\fontsize{7pt}{8.5pt}\selectfont}
\renewcommand{\RKTokPresentationCardGutter}{5mm}
\renewcommand{\RKTokPresentationCardPadding}{4.5mm}
\renewcommand{\RKTokPresentationCardMinHeight}{32mm}
\renewcommand{\RKTokPresentationCardRuleWidth}{0pt}
\renewcommand{\RKTokPresentationProseWidth}{100mm}
\renewcommand{\RKTokPresentationBodyFont}{\fontsize{13pt}{17pt}\selectfont}
\renewcommand{\RKTokPresentationCaptionFont}{\fontsize{8pt}{9.6pt}\selectfont}
\renewcommand{\RKTokPresentationHeroValueFont}{\rkventure@displayface\fontsize{76pt}{78pt}\selectfont}
\renewcommand{\RKTokPresentationHeroLabelFont}{\fontsize{12pt}{15pt}\selectfont}
\renewcommand{\RKTokPresentationColumnHeadingFont}{\rkventure@displayface\fontsize{15pt}{18pt}\selectfont}
\renewcommand{\RKTokPresentationClosingFont}{\rkventure@displayface\fontsize{32pt}{36pt}\selectfont}
\renewcommand{\RKTokPresentationRuleWidth}{2pt}
\rk@presentationtokensloadedtrue

\endinput
