% ReportKit theme adapter: venture / slides renderer. Phase D pitch-deck
% frame geometry, light/dark frame surfaces, brand logo placement, and the
% presentation token scale.
%
% Owns what reportkit-theme-executive-slides.sty owns for executive -- the
% safe-area margin inside reportkit-slides.cls's 160mm x 90mm frame, running
% chrome, and every presentation-composition token -- plus the one
% theme-specific behavior venture adds: mapping the renderer-neutral
% \RKTokPresentationSurface roles to light or dark (inverse) frames. The
% compositions in reportkit-presentation.sty are unchanged and unaware of it.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-venture-slides}[2026/09/23 v0.1.0 ReportKit venture theme / slides adapter]
\RequirePackage{tikz}

% -----------------------------------------------------------------------------
% Canvas and safe margin
% -----------------------------------------------------------------------------
% 12mm each side (136mm usable width): more negative space than executive's
% 8mm. python_scripts/reportkit/themes/venture.py derives its slide slots
% from this same 136mm figure; update both together.
\setbeamersize{text margin left=12mm,text margin right=12mm}

% -----------------------------------------------------------------------------
% Frame surfaces (Phase D light and dark frames)
% -----------------------------------------------------------------------------
% Opening, divider, statement and closing roles render on a dark frame;
% metric and content roles stay light. The role hook runs inside the
% composition's own group, so the colour re-pointing below is local to that
% composition, while the global flag tells the background canvas and
% footline -- both typeset at shipout, after the frame body -- which surface
% to paint. The flag is reset before every frame so a frame without a
% composition (plain Markdown content) is always light.
\newif\ifrkventure@inverse
\rkventure@inversefalse
\AddToHook{env/frame/before}{\global\rkventure@inversefalse}
\@namedef{rkventure@inverse@opening}{}
\@namedef{rkventure@inverse@divider}{}
\@namedef{rkventure@inverse@statement}{}
\@namedef{rkventure@inverse@closing}{}
\newcommand{\rkventure@useinversecolors}{%
  \colorlet{Accent}{Research}%
  \colorlet{LinkBlue}{Research}%
  \colorlet{Ink}{VentureInverseInk}%
  \colorlet{Muted}{VentureInverseMuted}%
  \colorlet{Hairline}{VentureInverseHairline}%
  \colorlet{Surface}{VentureInverseSurface}%
  \color{Ink}%
}
\renewcommand{\RKTokPresentationSurface}[1]{%
  \ifcsname rkventure@inverse@#1\endcsname
    \global\rkventure@inversetrue
    \rkventure@useinversecolors
  \else
    \global\rkventure@inversefalse
  \fi
}

% A brand logo sits on a small light chip on dark frames so any logo artwork
% stays legible, and directly in the footline on light frames.
\newcommand{\rkventure@logochip}{%
  \rkventure@iflogo{%
    \node[anchor=north east,fill=white,rounded corners=1.2mm,inner sep=1.6mm]
      at (\paperwidth-12mm,\paperheight-7mm) {\includegraphics[height=4.2mm]{\RKBrandLogo}};%
  }{}%
}
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \ifrkventure@inverse
      \fill[VentureNight] (0,0) rectangle (\paperwidth,\paperheight);
      \fill[Research] (12mm,6mm) rectangle (30mm,7.2mm);
      \rkventure@logochip
    \else
      \fill[white] (0,0) rectangle (\paperwidth,\paperheight);
    \fi
  \end{tikzpicture}%
}

% -----------------------------------------------------------------------------
% Running chrome -- a quiet footline: source citation in a fixed left box,
% frame number in a dedicated right box. No headline; compositions carry
% their own heading type. Keeping the boxes separate prevents the citation
% and page number from reading as one string in PDF extraction.
% -----------------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[wd=\dimexpr\paperwidth-24mm\relax,ht=4.2mm,dp=2.6mm,leftskip=12mm,rightskip=0pt]{}
      \ifrkventure@inverse
        {\sffamily\RKTokPresentationSourceFont\color{VentureInverseMuted}\rk@footer}%
      \else
        \rkventure@iflogo{%
          \raisebox{-.8mm}{\includegraphics[height=3.6mm]{\RKBrandLogo}}%
        }{%
          {\sffamily\RKTokPresentationSourceFont\color{Muted}\rk@footer}%
        }%
      \fi
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=24mm,ht=4.2mm,dp=2.6mm,leftskip=0pt,rightskip=12mm]{}
      \hfill
      \ifrkventure@inverse
        \raisebox{2.5mm}{\sffamily\bfseries\RKTokPresentationSourceFont\color{VentureInverseMuted}\insertframenumber}%
      \else
        \raisebox{2.5mm}{\sffamily\bfseries\RKTokPresentationSourceFont\color{Accent}\insertframenumber}%
      \fi
    \end{beamercolorbox}%
  }
}

% -----------------------------------------------------------------------------
