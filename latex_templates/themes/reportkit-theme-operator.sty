% ReportKit theme: operator. Wave 0 supplies the registered palette and
% contract-complete defaults; Lane O replaces the appearance values.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-operator}[2026/09/30 v1.0.0 ReportKit operator theme]
\RequirePackage{iftex}
\ifPDFTeX\else
  \PackageError{reportkit-theme-operator}{The operator theme requires pdfLaTeX}{Select the pdflatex engine for theme=operator.}
  \expandafter\endinput
\fi
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}

