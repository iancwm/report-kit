% The shared callout primitive appends these keys after its base appearance.
% Its legacy semantic rail stays at zero width; these per-kind left borders
% match the box rule so every card has a uniform outline.
\renewcommand{\RKTokCalloutKindOptions}[1]{%
  \ifstrequal{#1}{Limitation}%
    {colframe=Hairline,colback=SurfaceAlt,boxrule=.6pt,leftrule=.6pt}{%
  \ifstrequal{#1}{Assumption}%
    {colframe=Accent,colback=SurfaceAlt,boxrule=.8pt,leftrule=.8pt}{%
  \ifstrequal{#1}{RedFlag}%
    {colframe=RedFlag,colback=Surface,boxrule=.8pt,leftrule=.8pt}{%
  \ifstrequal{#1}{Decision}%
    {colframe=InkStrong,colback=Surface,boxrule=1pt,leftrule=1pt}{%
    colframe=Hairline,colback=SurfaceAlt,boxrule=.6pt,leftrule=.6pt%
  }}}}
}
