% ReportKit theme: operator. Experimental pdfLaTeX theme for technical reports.
% This common package owns fonts, palette and renderer-neutral tokens; its
% paged adapter owns page furniture and composition.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-operator}[2026/09/30 v1.0.0 ReportKit operator theme]
\RequirePackage{iftex}
\RequirePackage{etoolbox}
\ifPDFTeX\else
  \PackageError{reportkit-theme-operator}{The operator theme requires pdfLaTeX}{Select the pdflatex engine for theme=operator.}
  \expandafter\endinput
\fi
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
% Deliberate typography revision: Latin Modern Sans is the operator default text
% family (prose, lists, notes, ordinary table/callout text). \ttfamily and math
% keep their own fonts; \normalfont and inheriting tokens resolve to sans.
\renewcommand{\familydefault}{\sfdefault}

