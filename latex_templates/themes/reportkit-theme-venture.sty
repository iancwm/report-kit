% ReportKit theme: venture -- the brand-forward startup/pitch visual system
% for the slides renderer. Phase D of the multi-format publication
% architecture spec (§12.2, decisions D6, D8, D9): large type, lower density,
% strong negative space, light and dark frames, product imagery and bold
% metrics. It styles exactly the same reportkit-presentation.sty
% compositions the executive theme styles; there is no venture composition
% layer and no venture-only composition name.
%
% Owns fonts, palette, the constrained brand hooks, and renderer-neutral
% semantic appearance -- the same split A4/D11 established for every other
% theme. Canvas margins, running chrome, frame surfaces (light/dark) and the
% presentation token scale live in reportkit-theme-venture-slides.sty, this
% theme's only registered adapter.
%
% Controlled branding (D6). The registry marks venture as the only theme
% with brand_overrides: true. The pipeline materializes the four brand keys
% (primary, secondary, logo, display_font) from one EffectiveTheme record
% into reportkit-theme-overrides.tex, which re-points the palette names below
% (LinkBlue/Principle/Accent/MetricAccent for primary, Research for
% secondary) and calls the font setters defined here. Nothing else about the
% theme is configurable.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-venture}[2026/09/23 v0.1.0 ReportKit venture theme]

% -----------------------------------------------------------------------------
% Engine guard (decision D9: new visual themes require LuaLaTeX)
% -----------------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{reportkit-theme-venture}%
    {The venture theme requires LuaLaTeX}%
    {Compile with lualatex, or set document.engine: lualatex in publication.yaml.}
\fi

% -----------------------------------------------------------------------------
% Fonts. Body and default display face: the bundled Google Sans static faces
% (font_data/, installed by the pinned toolchain image), loaded by file name
% so the Bold face resolves even though the static files share one family
% style name. brand.display_font / theme.font_family replace only the display
% face (titles, statements, hero metrics, closing); body, table and source
% roles keep the body face so a brand font cannot break dense evidence text.
% -----------------------------------------------------------------------------
\RequirePackage{fontspec}
\newcommand{\rkventure@defaultdisplay}{Google Sans}
\newcommand{\rkventure@displayname}{Google Sans}
\newcommand{\rkventure@fontpath}{}
% Public setters shared with the other LuaLaTeX themes' vocabulary; the
% generated override file calls them only when they exist.
\newcommand{\setreportkitfontfamily}[1]{\renewcommand{\rkventure@displayname}{#1}}
% A directory containing <family>-Regular.ttf and <family>-Bold.ttf (with
% any spaces removed from <family>), including the trailing slash.
\newcommand{\setreportkitfontpath}[1]{\renewcommand{\rkventure@fontpath}{#1}}
% \rk@fontpolicy and \setreportkitfontpolicy are defined by reportkit-core.sty
% because strict also makes missing glyphs fatal under every theme.

\newcommand{\rkventure@setbodyfamily}[1]{\setmainfont{#1}\setsansfont{#1}}
\IfFontExistsTF{GoogleSans-Regular.ttf}{%
  \setmainfont{GoogleSans}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold]%
  \setsansfont{GoogleSans}[Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold]%
}{%
  \IfFontExistsTF{Inter}{%
    \rkventure@setbodyfamily{Inter}%
    \PackageWarningNoLine{reportkit-theme-venture}{WARN Google Sans unavailable; using Inter}%
  }{%
    \IfFontExistsTF{Noto Sans}{%
      \rkventure@setbodyfamily{Noto Sans}%
      \PackageWarningNoLine{reportkit-theme-venture}{WARN Google Sans unavailable; using Noto Sans}%
    }{%
      \rkventure@setbodyfamily{TeX Gyre Heros}%
      \PackageWarningNoLine{reportkit-theme-venture}{WARN Google Sans unavailable; using TeX Gyre Heros}%
    }%
  }%
}

% Display face switch used by the adapter's display-role font tokens. Empty
% means "the body family in bold", which is the unbranded default.
\newcommand{\rkventure@displayface}{}
\newcommand{\rkventure@displayunavailable}{%
  \ifdefstring{\rk@fontpolicy}{strict}{%
    \PackageError{reportkit-theme-venture}%
      {FAIL brand display font \rkventure@displayname\space is unavailable}%
      {Install the font, set theme.font_path to a directory containing it, or set theme.font_policy: fallback.}%
  }{%
    \PackageWarningNoLine{reportkit-theme-venture}%
      {WARN brand display font \rkventure@displayname\space unavailable; using the body face}%
  }%
}
\newcommand{\rkventure@resolvedisplay}{%
  \ifdefstring{\rkventure@displayname}{\rkventure@defaultdisplay}{%
    \PackageInfo{reportkit-theme-venture}{PASS venture display font: \rkventure@displayname}%
  }{%
    \edef\rkventure@fontpathval{\rkventure@fontpath}%
    \ifx\rkventure@fontpathval\@empty
      \IfFontExistsTF{\rkventure@displayname}{%
        \newfontfamily\rkventure@displayfamily{\rkventure@displayname}%
        \renewcommand{\rkventure@displayface}{\rkventure@displayfamily}%
        \PackageInfo{reportkit-theme-venture}{PASS venture display font: \rkventure@displayname}%
      }{\rkventure@displayunavailable}%
    \else
      \edef\rkventure@displayfile{\directlua{tex.sprint((string.gsub("\luaescapestring{\rkventure@displayname}", " ", "")))}}%
      \IfFileExists{\rkventure@fontpath\rkventure@displayfile-Regular.ttf}{%
        \newfontfamily\rkventure@displayfamily{\rkventure@displayfile}[
          Path=\rkventure@fontpath,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,
        ]%
        \renewcommand{\rkventure@displayface}{\rkventure@displayfamily}%
        \PackageInfo{reportkit-theme-venture}{PASS venture display font: \rkventure@displayname\space (local path \rkventure@fontpath)}%
      }{\rkventure@displayunavailable}%
    \fi
  }%
}
\AtBeginDocument{\rkventure@resolvedisplay}

% -----------------------------------------------------------------------------
% Brand logo (D6). The generated override file defines \RKBrandLogo (a
% root-relative path to the hashed, staged asset, or empty). Direct TeX
% documents that never load an override file simply have no logo.
% -----------------------------------------------------------------------------
\newcommand{\rkventure@iflogo}[2]{\ifcsvoid{RKBrandLogo}{#2}{#1}}

