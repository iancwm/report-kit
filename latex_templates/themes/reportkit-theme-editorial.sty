% -----------------------------------------------------------------------------
% Reading body. Book-like paragraphs: first-line indents, no paragraph
% skip, a slightly larger body than the report themes for long reading.
% -----------------------------------------------------------------------------
\renewcommand{\normalsize}{\@setfontsize{\normalsize}{10.6pt}{14.6pt}}
\normalsize
\setlength{\parindent}{1.1em}
\setlength{\parskip}{0pt plus .5pt}
\setlist{nosep,leftmargin=1.3em,topsep=4pt}
\sisetup{detect-all=true,group-separator={,}}
\captionsetup{font={sf,small},labelfont=bf,labelsep=period,singlelinecheck=false,skip=4pt}
\renewcommand{\arraystretch}{1.08}

