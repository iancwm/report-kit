% ReportKit theme: editorial -- magazine and thought-leadership reading for
% the paged renderer. Phase E of the multi-format publication architecture
% spec (docs/superpowers/specs/2026-09-09-reportkit-multi-format-publication-architecture-spec.md,
% section 12.3): strong editorial typography, a serif reading body, a
% complementary sans for metadata and labels, and storytelling through text
% and visual rhythm rather than report furniture.
%
% Owns fonts, palette and renderer-neutral semantic appearance -- the same
% common/adapter split A4/D11 established for every theme. Geometry, running
% furniture, section headings, \maketitle and the feature-composition tokens
% read by reportkit-feature-article.sty live in
% reportkit-theme-editorial-paged.sty, this theme's only registered adapter.
%
% Language coverage (declared, not aspirational): the Libertinus families
% below contain Latin, Latin Extended, Greek and Cyrillic glyphs, including
% the stacked diacritics Vietnamese needs, but only English Latin-script
% typography is exercised by a reviewed fixture. The publication registry
% and reportkit/themes/editorial.py therefore declare Latn/en as verified,
% Vietnamese as metadata-only, every other script as undeclared, and RTL as
% unsupported.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-editorial}[2026/09/23 v1.0.0 ReportKit editorial theme]

% -----------------------------------------------------------------------------
% Engine guard (decision D9: new visual themes require LuaLaTeX)
% -----------------------------------------------------------------------------
% config.py's theme_engine_conflict() and the publication registry refuse a
% non-LuaLaTeX build before any compiler runs; this repeats the rule at the
% TeX level for direct lualatex/pdflatex invocations.
\RequirePackage{iftex}
\RequirePackage{etoolbox}
\ifPDFTeX
  \PackageError{reportkit-theme-editorial}%
    {The editorial theme requires LuaLaTeX}%
    {Compile with lualatex, or set document.engine: lualatex in publication.yaml.}
\fi

% -----------------------------------------------------------------------------
% Fonts -- Libertinus Serif for the reading body, Libertinus Sans as the
% complementary metadata/label face, Libertinus Serif Display for headline
% sizes and Libertinus Serif Initials for drop caps. All four ship in the
% pinned toolchain's bundled Libertinus archive (font_data/), so direct and
% pipeline builds resolve the same faces without consumer font setup.
% -----------------------------------------------------------------------------
\RequirePackage{libertinus}
\newfontfamily\rkeditorialdisplay{Libertinus Serif Display}
\newfontfamily\rkeditorialinitials{Libertinus Serif Initials}

% -----------------------------------------------------------------------------
% Palette. Warm ink on white with one oxblood accent; secondary data colors
% are muted slate, ochre and sage so charts sit quietly beside the prose.
% Kept in sync with reportkit/themes/editorial.py (check-theme --theme
% editorial).
% -----------------------------------------------------------------------------
