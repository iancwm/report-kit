\definecolor{Hairline}{HTML}{D9DEE5}
\definecolor{LinkBlue}{HTML}{2C5E78}
\definecolor{Principle}{HTML}{2C5E78}
\definecolor{Decision}{HTML}{68558A}
\definecolor{Research}{HTML}{2B7074}
\definecolor{Tip}{HTML}{3F6D54}
\definecolor{RedFlag}{HTML}{A14B45}
\definecolor{Assumption}{HTML}{8A6A24}
\definecolor{Evidence}{HTML}{4B6472}
\definecolor{Limitation}{HTML}{6E6A67}
\definecolor{MetricAccent}{HTML}{315E86}
\definecolor{Surface}{HTML}{F7F8FA}
% v1.2 addition, paired with the \deliverablenote callout in
% reportkit-boxes.sty. Mirrored in reportkit_viz.py's LATEX_THEME_COLORS.
\definecolor{Deliverable}{HTML}{2C6E49}

\color{Ink}
\hypersetup{colorlinks=true,linkcolor=LinkBlue,urlcolor=LinkBlue,citecolor=LinkBlue,pdfborder={0 0 0},pdfdisplaydoctitle=true}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.5pt plus 1pt minus .5pt}
\setlist{nosep,leftmargin=1.45em,topsep=3pt}
\sisetup{detect-all=true,group-separator={,}}
\captionsetup{font=small,labelfont=bf,labelsep=period,singlelinecheck=false,skip=4pt}

% -----------------------------------------------------------------------------
% Style tokens (reportkit-core.sty's contract) -- callout and metric chrome.
% This is the pre-v1.3.0 callout chrome and the metric card's only styling
% (both were hardcoded in reportkit-boxes.sty before Phase A4; see that
% file's own note). Category colors (Principle, Decision, RedFlag, ...) and
% MetricAccent above are unaffected -- these tokens style the box itself.
% -----------------------------------------------------------------------------
\renewcommand{\RKTokCalloutColBack}{Surface}
\renewcommand{\RKTokCalloutColFrame}{Hairline}
\renewcommand{\RKTokCalloutBoxRule}{.45pt}
\renewcommand{\RKTokCalloutLeftRule}{2.2pt}
\renewcommand{\RKTokCalloutArc}{0pt}
\renewcommand{\RKTokCalloutOuterArc}{0pt}
\renewcommand{\RKTokCalloutPadLeft}{8pt}
\renewcommand{\RKTokCalloutPadRight}{8pt}
\renewcommand{\RKTokCalloutPadTop}{6pt}
\renewcommand{\RKTokCalloutPadBottom}{6pt}
\renewcommand{\RKTokCalloutBeforeSkip}{6pt}
\renewcommand{\RKTokCalloutAfterSkip}{7pt}
\renewcommand{\RKTokCalloutTitleFont}{\fontsize{7.3}{8.5}\selectfont}
\renewcommand{\RKTokMetricColBack}{white}
\renewcommand{\RKTokMetricColFrame}{Hairline}
\renewcommand{\RKTokMetricBoxRule}{.45pt}
\renewcommand{\RKTokMetricArc}{0pt}
\renewcommand{\RKTokMetricOuterArc}{0pt}
\renewcommand{\RKTokMetricPadLeft}{10pt}
\renewcommand{\RKTokMetricPadRight}{10pt}
\renewcommand{\RKTokMetricPadTop}{8pt}
\renewcommand{\RKTokMetricPadBottom}{8pt}
\renewcommand{\RKTokMetricBeforeSkip}{7pt}
\renewcommand{\RKTokMetricAfterSkip}{8pt}
\renewcommand{\RKTokMetricBorderLineWidth}{2.4pt}
\renewcommand{\RKTokMetricLabelFont}{\fontsize{7.3}{8.5}\selectfont}
\renewcommand{\RKTokMetricValueFont}{\fontsize{21}{23}\selectfont}
\renewcommand{\RKTokMetricSubtitleFont}{\fontsize{8.3}{10}\selectfont}
\renewcommand{\RKTokMetricSubtitleSpacing}{4pt}
\renewcommand{\RKTokMetricWhyFont}{\fontsize{7.2}{8.4}\selectfont}
\rk@styletokensloadedtrue

% <reportkit-contract>
% {"kind":"callout","description":"Execsummary","arguments":[],"constraints":[],"example":"\\begin{execsummary}\nExample content.\n\\end{execsummary}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{execsummary}{}{%
  \par\RKReserveSpace{8\baselineskip}%
  \begin{list}{}{\setlength{\leftmargin}{0pt}\setlength{\rightmargin}{0pt}}\item\relax
  \color{Ink}\sffamily\small\textbf{EXECUTIVE SUMMARY}\par\vspace{2pt}\rmfamily\normalsize
}{%
  \end{list}\vspace{3pt}
}

% Figure/table provenance helper.
\newcommand{\source}[1]{\par\vspace{1pt}{\sffamily\fontsize{7.4}{9}\selectfont\color{Muted}\textit{Source:} #1}\par}

\endinput
