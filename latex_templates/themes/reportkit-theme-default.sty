% ReportKit theme: default -- the original ReportKit visual identity, moved
% verbatim out of reportkit.cls v1.5.0 by the theme architecture in
% docs/superpowers/specs/2026-09-09-reportkit-institutional-theme-and-equity-profile-spec.md.
% This file owns fonts, palette, and renderer-neutral semantic appearance.
% reportkit.cls loads reportkit-core.sty (engine-neutral mechanism) before
% this file, so core's macros and packages are available here.
%
% Selected automatically by `\documentclass{reportkit}` (no theme= option) or
% `\documentclass[theme=default]{reportkit}`. Every existing ReportKit
% publication uses this theme; its output is unchanged by the theme split --
% nothing below was rewritten, only relocated.
%
% Phase A4 (decision D11) split this file again: geometry, running
% furniture, section-heading placement, and \maketitle -- all page-specific --
% moved verbatim to reportkit-theme-default-paged.sty, loaded by reportkit.cls
% immediately after this file. What remains here is renderer-neutral: fonts,
% palette, typography defaults, the semantic style-token contract (see
% reportkit-core.sty's "Style token contract" section) that
% reportkit-boxes.sty now reads instead of branching on \rk@theme, execsummary
% (an ordinary list environment, not page machinery), and the source helper.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-theme-default}[2026/09/13 v1.8.0 ReportKit default theme]

% -----------------------------------------------------------------------------
% Fonts
% -----------------------------------------------------------------------------
% v1.2.1 fix: fontenc/inputenc and libertinust1math are pdfTeX-only concerns.
% Under luaTeX/XeTeX, libertinus.sty already auto-loads correct OpenType math
% support via unicode-math; separately loading the legacy T1 math companion
% package on top of that clobbers operator glyph mappings (observed: \times
% rendered as the wrong glyph -- resembling \propto -- once both were loaded
% together under lualatex). Guard both by engine so each engine gets exactly
% the math setup it needs, and no more.
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\fi
\RequirePackage{libertinus}
\ifPDFTeX
  \RequirePackage{libertinust1math}
\fi

