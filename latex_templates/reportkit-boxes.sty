% {"kind":"callout","description":"Tipnote","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{tipnote}[Example]\nExample content.\n\\end{tipnote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{tipnote}{o g}{\rk@begin@callout{Tip}{TIP}{5\baselineskip}{#1}{#2}}{\end{rk@callout}}

% v1.2 addition: many process/workflow reports end a module with a named
% output artifact (a brief, a matrix, a tracker) that the reader is meant to
% produce or collect. That's a distinct semantic category from evidence,
% limitation, or tip -- it's neither a claim about the world nor guidance,
% it's "this step exists to yield deliverable X". Reuses \Deliverable color,
% defined in reportkit.cls's palette and mirrored in reportkit_viz.py's
% LATEX_THEME_COLORS for check-theme sync.
% <reportkit-contract>
% {"kind":"callout","description":"Deliverablenote","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{deliverablenote}[Example]\nExample content.\n\\end{deliverablenote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{deliverablenote}{o g}{\rk@begin@callout{Deliverable}{DELIVERABLE}{5\baselineskip}{#1}{#2}}{\end{rk@callout}}

% Compatibility aliases.
% <reportkit-contract>
% {"kind":"callout","description":"Evidence","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{evidence}[Example]\nExample content.\n\\end{evidence}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{evidence}{o g}{%
  \IfNoValueTF{#1}{\IfNoValueTF{#2}{\begin{evidencenote}}{\begin{evidencenote}{#2}}}%
    {\IfNoValueTF{#2}{\begin{evidencenote}[#1]}{\begin{evidencenote}[#1]{#2}}}%
}{\end{evidencenote}}
% <reportkit-contract>
% {"kind":"callout","description":"Limitation","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{limitation}[Example]\nExample content.\n\\end{limitation}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{limitation}{o g}{%
  \IfNoValueTF{#1}{\IfNoValueTF{#2}{\begin{limitationnote}}{\begin{limitationnote}{#2}}}%
    {\IfNoValueTF{#2}{\begin{limitationnote}[#1]}{\begin{limitationnote}[#1]{#2}}}%
}{\end{limitationnote}}
% <reportkit-contract>
% {"kind":"callout","description":"Tip","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{tip}[Example]\nExample content.\n\\end{tip}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{tip}{o g}{%
  \IfNoValueTF{#1}{\IfNoValueTF{#2}{\begin{tipnote}}{\begin{tipnote}{#2}}}%
    {\IfNoValueTF{#2}{\begin{tipnote}[#1]}{\begin{tipnote}[#1]{#2}}}%
}{\end{tipnote}}

% <reportkit-contract>
% {"kind":"callout","description":"Metric","arguments":[{"name":"label","type":"text","description":"Label."},{"name":"value","type":"text","description":"Value."}],"constraints":[],"example":"\\begin{metric}{Example}{1}\nExample content.\n\\end{metric}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{metric}{m m}{%
  \par\RKReserveSpace{9\baselineskip}%
  \begin{tcolorbox}[
    enhanced,breakable,colback=\RKTokMetricColBack,colframe=\RKTokMetricColFrame,
    boxrule=\RKTokMetricBoxRule,
    arc=\RKTokMetricArc,outer arc=\RKTokMetricOuterArc,
    left=\RKTokMetricPadLeft,right=\RKTokMetricPadRight,
    top=\RKTokMetricPadTop,bottom=\RKTokMetricPadBottom,
    before skip=\RKTokMetricBeforeSkip,after skip=\RKTokMetricAfterSkip,
    borderline west={\RKTokMetricBorderLineWidth}{0pt}{MetricAccent}]
  {\sffamily\RKTokMetricLabelFont\bfseries\color{MetricAccent}METRIC\par}
  {\sffamily\bfseries\RKTokMetricValueFont\color{Ink}#1\par}
  {\sffamily\RKTokMetricSubtitleFont\color{Muted}#2\par\vspace{\RKTokMetricSubtitleSpacing}}
  {\sffamily\RKTokMetricWhyFont\bfseries\color{MetricAccent}WHY IT MATTERS\quad}\ignorespaces
}{%
  \end{tcolorbox}
}

\endinput
