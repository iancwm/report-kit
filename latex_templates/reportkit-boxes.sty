% ReportKit v1.5.0 -- semantic callouts and metric object
% v1.4.0 (Phase A3): space reservation now goes through the renderer hook
% \RKReserveSpace (see reportkit-core.sty/reportkit-paged-core.sty) instead
% of calling \Needspace directly, so this module no longer requires
% needspace itself and compiles unchanged under any renderer core.
% v1.5.0 (Phase A4, decision D2): callout chrome and the metric card no
% longer branch on \rk@theme. Both now read reportkit-core.sty's style-token
% contract, populated by whichever theme package loaded before this one --
% the institutional-research theme's quieter chrome (spec §21: "thin left
% rule, small uppercase semantic label, minimal background or none") is
% exactly the same values as before, just moved into
% themes/reportkit-theme-institutional-research.sty instead of living here as
% a branch. \RKAssertStyleTokens fails loudly (naming the missing theme) if
% this module is somehow reached before a theme populated the tokens.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-boxes}[2026/09/13 v1.5.0 ReportKit semantic boxes]
\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{etoolbox}

\RKAssertStyleTokens

\newtcolorbox{rk@callout}[3][]{%
  enhanced,
  breakable,
  colback=\RKTokCalloutColBack,
  colframe=\RKTokCalloutColFrame,
  boxrule=\RKTokCalloutBoxRule,
  leftrule=\RKTokCalloutLeftRule,
  arc=\RKTokCalloutArc,
  outer arc=\RKTokCalloutOuterArc,
  left=\RKTokCalloutPadLeft,right=\RKTokCalloutPadRight,
  top=\RKTokCalloutPadTop,bottom=\RKTokCalloutPadBottom,
  before skip=\RKTokCalloutBeforeSkip,after skip=\RKTokCalloutAfterSkip,
  borderline west={\RKTokCalloutLeftRule}{0pt}{#2},
  title={\sffamily\RKTokCalloutTitleFont\bfseries\color{#2}\MakeUppercase{#3}},
  fonttitle=\sffamily,
  coltitle=#2,
  attach title to upper={\quad},
  #1
}

% A semantic callout accepts a replacement heading in brackets and the old
% braced suffix during migration. The environment still owns colour/chrome;
% only the text passed to the shared box changes.
\newcommand{\rk@begin@callout}[5]{%
  \RKReserveSpace{#3}%
  \IfNoValueTF{#4}{%
    \IfNoValueTF{#5}%
      {\begin{rk@callout}{#1}{#2}}%
      {\begin{rk@callout}{#1}{#2\quad #5}}%
  }{%
    \IfNoValueTF{#5}{%
      \ifblank{#4}{\begin{rk@callout}{#1}{#2}}{\begin{rk@callout}{#1}{#4}}%
    }{%
      \PackageError{reportkit-boxes}%
        {Callout title forms are mutually exclusive}%
        {Use [replacement] or {legacy suffix}, not both.}%
      \ifblank{#4}{\begin{rk@callout}{#1}{#2}}{\begin{rk@callout}{#1}{#4}}%
    }%
  }%
}

% <reportkit-contract>
% {"kind":"callout","description":"Principle","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{principle}[Example]\nExample content.\n\\end{principle}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{principle}{o g}{\rk@begin@callout{Principle}{PRINCIPLE}{6\baselineskip}{#1}{#2}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Decisionpoint","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{decisionpoint}[Example]\nExample content.\n\\end{decisionpoint}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{decisionpoint}{o g}{\rk@begin@callout{Decision}{DECISION POINT}{6\baselineskip}{#1}{#2}}{\end{rk@callout}}
