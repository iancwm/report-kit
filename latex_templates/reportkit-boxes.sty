% ReportKit v1.5.0 -- semantic callouts and metric object
% v1.4.0 (Phase A3): space reservation now goes through the renderer hook
% \RKReserveSpace (see reportkit-core.sty/reportkit-paged-core.sty) instead
% of calling \Needspace directly, so this module no longer requires
% needspace itself and compiles unchanged under any renderer core.
% v1.5.0 (Phase A4, decision D2): callout chrome and the metric card no
% longer branch on \rk@theme. Both now read reportkit-core.sty's style-token
% contract, populated by whichever theme package loaded before this one --
% the institutional-research theme's quieter chrome (spec §21: "thin left
% rule, small uppercase semantic label, minimal background or none") is
% exactly the same values as before, just moved into
% themes/reportkit-theme-institutional-research.sty instead of living here as
% a branch. \RKAssertStyleTokens fails loudly (naming the missing theme) if
% this module is somehow reached before a theme populated the tokens.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-boxes}[2026/09/13 v1.5.0 ReportKit semantic boxes]
\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{etoolbox}

\RKAssertStyleTokens

\newtcolorbox{rk@callout}[3][]{%
  enhanced,
  breakable,
  colback=\RKTokCalloutColBack,
  colframe=\RKTokCalloutColFrame,
  boxrule=\RKTokCalloutBoxRule,
  leftrule=\RKTokCalloutLeftRule,
  arc=\RKTokCalloutArc,
  outer arc=\RKTokCalloutOuterArc,
  left=\RKTokCalloutPadLeft,right=\RKTokCalloutPadRight,
  top=\RKTokCalloutPadTop,bottom=\RKTokCalloutPadBottom,
  before skip=\RKTokCalloutBeforeSkip,after skip=\RKTokCalloutAfterSkip,
  borderline west={\RKTokCalloutLeftRule}{0pt}{#2},
  title={\sffamily\RKTokCalloutTitleFont\bfseries\color{#2}\MakeUppercase{#3}},
  fonttitle=\sffamily,
  coltitle=#2,
  attach title to upper={\quad},
  #1
}

% <reportkit-contract>
% {"kind":"callout","description":"Principle","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{principle}{Example}\nExample content.\n\\end{principle}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{principle}{m}{\RKReserveSpace{6\baselineskip}\begin{rk@callout}{Principle}{PRINCIPLE\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Decisionpoint","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{decisionpoint}{Example}\nExample content.\n\\end{decisionpoint}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{decisionpoint}{m}{\RKReserveSpace{6\baselineskip}\begin{rk@callout}{Decision}{DECISION POINT\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Researchproblem","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{researchproblem}{Example}\nExample content.\n\\end{researchproblem}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{researchproblem}{m}{\RKReserveSpace{6\baselineskip}\begin{rk@callout}{Research}{RESEARCH PROBLEM\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Assumption","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{assumption}{Example}\nExample content.\n\\end{assumption}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{assumption}{m}{\RKReserveSpace{6\baselineskip}\begin{rk@callout}{Assumption}{ASSUMPTION\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Redflag","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{redflag}{Example}\nExample content.\n\\end{redflag}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{redflag}{m}{\RKReserveSpace{6\baselineskip}\begin{rk@callout}{RedFlag}{RED FLAG\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Evidencenote","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{evidencenote}{Example}\nExample content.\n\\end{evidencenote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{evidencenote}{m}{\RKReserveSpace{5\baselineskip}\begin{rk@callout}{Evidence}{EVIDENCE\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Limitationnote","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{limitationnote}{Example}\nExample content.\n\\end{limitationnote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{limitationnote}{m}{\RKReserveSpace{5\baselineskip}\begin{rk@callout}{Limitation}{LIMITATION\quad #1}}{\end{rk@callout}}
% <reportkit-contract>
% {"kind":"callout","description":"Tipnote","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{tipnote}{Example}\nExample content.\n\\end{tipnote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{tipnote}{m}{\RKReserveSpace{5\baselineskip}\begin{rk@callout}{Tip}{TIP\quad #1}}{\end{rk@callout}}

% v1.2 addition: many process/workflow reports end a module with a named
% output artifact (a brief, a matrix, a tracker) that the reader is meant to
% produce or collect. That's a distinct semantic category from evidence,
% limitation, or tip -- it's neither a claim about the world nor guidance,
% it's "this step exists to yield deliverable X". Reuses \Deliverable color,
% defined in reportkit.cls's palette and mirrored in reportkit_viz.py's
% LATEX_THEME_COLORS for check-theme sync.
% <reportkit-contract>
% {"kind":"callout","description":"Deliverablenote","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{deliverablenote}{Example}\nExample content.\n\\end{deliverablenote}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{deliverablenote}{m}{\RKReserveSpace{5\baselineskip}\begin{rk@callout}{Deliverable}{DELIVERABLE\quad #1}}{\end{rk@callout}}

% Compatibility aliases.
% <reportkit-contract>
% {"kind":"callout","description":"Evidence","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{evidence}{Example}\nExample content.\n\\end{evidence}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{evidence}{m}{\begin{evidencenote}{#1}}{\end{evidencenote}}
% <reportkit-contract>
% {"kind":"callout","description":"Limitation","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{limitation}{Example}\nExample content.\n\\end{limitation}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{limitation}{m}{\begin{limitationnote}{#1}}{\end{limitationnote}}
% <reportkit-contract>
% {"kind":"callout","description":"Tip","arguments":[{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\begin{tip}{Example}\nExample content.\n\\end{tip}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{tip}{m}{\begin{tipnote}{#1}}{\end{tipnote}}

% <reportkit-contract>
% {"kind":"callout","description":"Metric","arguments":[{"name":"label","type":"text","description":"Label."},{"name":"value","type":"text","description":"Value."}],"constraints":[],"example":"\\begin{metric}{Example}{1}\nExample content.\n\\end{metric}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{metric}{m m}{%
  \par\RKReserveSpace{9\baselineskip}%
  \begin{tcolorbox}[
    enhanced,breakable,colback=\RKTokMetricColBack,colframe=\RKTokMetricColFrame,
    boxrule=\RKTokMetricBoxRule,
    arc=\RKTokMetricArc,outer arc=\RKTokMetricOuterArc,
    left=\RKTokMetricPadLeft,right=\RKTokMetricPadRight,
    top=\RKTokMetricPadTop,bottom=\RKTokMetricPadBottom,
    before skip=\RKTokMetricBeforeSkip,after skip=\RKTokMetricAfterSkip,
    borderline west={\RKTokMetricBorderLineWidth}{0pt}{MetricAccent}]
  {\sffamily\RKTokMetricLabelFont\bfseries\color{MetricAccent}METRIC\par}
  {\sffamily\bfseries\RKTokMetricValueFont\color{Ink}#1\par}
  {\sffamily\RKTokMetricSubtitleFont\color{Muted}#2\par\vspace{\RKTokMetricSubtitleSpacing}}
  {\sffamily\RKTokMetricWhyFont\bfseries\color{MetricAccent}WHY IT MATTERS\quad}\ignorespaces
}{%
  \end{tcolorbox}
}

\endinput
