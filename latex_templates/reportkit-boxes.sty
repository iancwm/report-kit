% {"kind":"callout","description":"Researchproblem","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{researchproblem}[Example]\nExample content.\n\\end{researchproblem}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{researchproblem}{o g}{\rk@begin@callout{Research}{RESEARCH PROBLEM}{6\baselineskip}{#1}{#2}}{\end{rk@callout}}
