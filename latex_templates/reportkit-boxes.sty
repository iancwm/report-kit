% {"kind":"callout","description":"Evidencenote","arguments":[{"name":"title","type":"text","description":"Optional replacement title; replaces the semantic default."},{"name":"legacy_suffix","type":"text","description":"Optional legacy braced suffix appended to the semantic default."}],"constraints":[],"example":"\\begin{evidencenote}[Example]\nExample content.\n\\end{evidencenote}","stability":"stable","since":"1.0.0"}
