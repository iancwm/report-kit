% ReportKit v1.5.0 -- state, comparison, and timeline primitives.
% These semantic forms complement flows: state recovery, before/after change,
% and events observed on more than one clock.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-grammar}[2026/09/06 v1.5.0 ReportKit semantic grammar]
\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}

% -----------------------------------------------------------------------------
% State machines
% -----------------------------------------------------------------------------
\tikzset{
  rk terminal/.style={rk node,draw=LinkBlue,line width=.9pt,double,double distance=1.2pt},
  rk transition label/.style={
    font=\sffamily\fontsize{7.0}{8.2}\selectfont,text=Muted,
    fill=Surface,inner sep=1.5pt,midway,above
  },
}
\newcommand{\rk@statestep}{4.2}
\newcount\rk@stateindex
\newcommand{\rk@transitionroute}{straight}
\newcommand{\rk@transitionlabelposition}{above}
\newcommand{\rk@transitionstyle}{}
\pgfkeys{
  /reportkit/state/.is family,
  /reportkit/state,
  step spacing/.store in=\rk@statestep,
}
\pgfkeys{
  /reportkit/state/transition/.is family,
  /reportkit/state/transition,
  route/.store in=\rk@transitionroute,
  routing/.store in=\rk@transitionroute,
  label-position/.store in=\rk@transitionlabelposition,
  style/.store in=\rk@transitionstyle,
  .unknown/.code={\PackageError{reportkit-grammar}{Unknown reportstate transition key '\pgfkeyscurrentname'}{Use route=straight, bend left=<degrees>, bend right=<degrees>, orthogonal, or label-position=above|below|left|right.}}
}
% <reportkit-contract>
% {"kind":"figure","description":"State transition diagram with explicit terminal states.","arguments":[{"name":"options","type":"options","description":"State layout keys."}],"constraints":[],"example":"\\begin{diagram}[caption={Task states.},description={A task moves from scheduled to running and done.}]\n\\begin{reportstate}\n\\state{scheduled}{Scheduled}\n\\state{running}{Running}\n\\terminalstate{done}{Done}\n\\transition{scheduled}{running}{start}\n\\transition{running}{done}{finish}\n\\end{reportstate}\n\\end{diagram}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{reportstate}{O{}}{%
  \begingroup\pgfkeys{/reportkit/state,step spacing=4.2,#1}%
  \rk@stateindex=0\relax
}{\endgroup}
% <reportkit-contract>
% {"kind":"command","description":"State","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"id","type":"text","description":"Id."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\state[]{a}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\state}{O{} m m}{%
  \node[rk node,#1] (#2) at ({\the\rk@stateindex*\rk@statestep},0) {\strut #3};%
  \advance\rk@stateindex by 1\relax
}
% <reportkit-contract>
% {"kind":"command","description":"Terminalstate","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"id","type":"text","description":"Id."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\terminalstate[]{a}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\terminalstate}{O{} m m}{%
  \node[rk terminal,#1] (#2) at ({\the\rk@stateindex*\rk@statestep},0) {\strut #3};%
  \advance\rk@stateindex by 1\relax
}
% <reportkit-contract>
% {"kind":"command","description":"Stateat","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"id","type":"text","description":"Id."},{"name":"x","type":"text","description":"X."},{"name":"y","type":"text","description":"Y."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\stateat[]{a}{1}{1}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\stateat}{O{} m m m m}{%
  \node[rk node,#1] (#2) at (#3,#4) {\strut #5};%
}
% <reportkit-contract>
% {"kind":"command","description":"Terminalstateat","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"id","type":"text","description":"Id."},{"name":"x","type":"text","description":"X."},{"name":"y","type":"text","description":"Y."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\terminalstateat[]{a}{1}{1}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\terminalstateat}{O{} m m m m}{%
  \node[rk terminal,#1] (#2) at (#3,#4) {\strut #5};%
}
\newcommand{\rk@transition@validlabelposition}{%
  \expandafter\ifstrequal\expandafter{\rk@transitionlabelposition}{above}{}{%
  \expandafter\ifstrequal\expandafter{\rk@transitionlabelposition}{below}{}{%
  \expandafter\ifstrequal\expandafter{\rk@transitionlabelposition}{left}{}{%
  \expandafter\ifstrequal\expandafter{\rk@transitionlabelposition}{right}{}{%
    \PackageError{reportkit-grammar}{Invalid reportstate label-position '\rk@transitionlabelposition'}{Use above, below, left, or right.}\def\rk@transitionlabelposition{above}%
  }}}}%
}
\ExplSyntaxOn
\prg_new_conditional:Npnn \rk_transition_route_bend:n #1 { T, F, TF }
  {
    \regex_match:nnTF
      { \A \s* bend \s+ (?: left | right ) \s* = \s* [-+]? (?: [0-9]+ | [0-9]* \. [0-9]+ ) \s* \Z }
      {#1} { \prg_return_true: } { \prg_return_false: }
  }
\cs_new_eq:NN \rk@transition@routebendTF \rk_transition_route_bend:nTF
\ExplSyntaxOff
\newcommand{\rk@transition@draw}[3]{%
  \rk@transition@validlabelposition
  \expandafter\ifstrequal\expandafter{\rk@transitionroute}{straight}{%
    \draw[rk edge flow,\rk@transitionstyle] (#1) -- node[midway,rk transition label,\rk@transitionlabelposition] {#3} (#2);%
  }{\expandafter\ifstrequal\expandafter{\rk@transitionroute}{orthogonal}{%
    \draw[rk edge flow,\rk@transitionstyle] (#1) |- node[midway,rk transition label,\rk@transitionlabelposition] {#3} (#2);%
  }{%
    \edef\rk@transitionroutevalue{\rk@transitionroute}%
    \expandafter\rk@transition@routebendTF\expandafter{\rk@transitionroutevalue}{%
      \edef\rk@transition@routedcommand{\noexpand\draw[rk edge flow,\rk@transitionstyle] (#1) to[\rk@transitionroute] node[midway,rk transition label,\rk@transitionlabelposition] {\unexpanded{#3}} (#2);}%
      \rk@transition@routedcommand
    }{%
      \PackageError{reportkit-grammar}{Unknown reportstate route '\rk@transitionroute'}{Use route=straight, bend left=<degrees>, bend right=<degrees>, or orthogonal.}%
      \draw[rk edge flow,\rk@transitionstyle] (#1) -- node[midway,rk transition label,\rk@transitionlabelposition] {#3} (#2);%
    }%
  }}%
}
% <reportkit-contract>
% {"kind":"command","description":"Transition","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"source","type":"text","description":"Source."},{"name":"target","type":"text","description":"Target."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\transition[]{a}{b}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\transition}{O{} m m m}{%
  \def\rk@transitionroute{straight}\def\rk@transitionlabelposition{above}\def\rk@transitionstyle{}%
  \in@{=}{#1}%
  \ifin@\pgfkeys{/reportkit/state/transition,#1}\else\def\rk@transitionstyle{#1}\fi
  \rk@transition@draw{#2}{#3}{#4}%
}
% <reportkit-contract>
% {"kind":"command","description":"Selfloop","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"state","type":"text","description":"State."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\selfloop[]{a}{Example}","stability":"stable","since":"1.0.0","parent":"reportstate"}
% </reportkit-contract>
\NewDocumentCommand{\selfloop}{O{} m m}{%
  \draw[rk edge flow,#1] (#2.north) .. controls +(0.7,1.1) and +(-0.7,1.1) .. (#2.north)
    node[rk transition label,above=6pt] {#3};%
}

% -----------------------------------------------------------------------------
% Before/after comparisons
% -----------------------------------------------------------------------------
\newcommand{\rk@comparegap}{2.6}
\newcommand{\rk@panelwidth}{5.4}
\newcommand{\rk@rowheight}{0.82}
\newcount\rk@panelindex
\pgfkeys{
  /reportkit/compare/.is family,
  /reportkit/compare,
  gap/.store in=\rk@comparegap,
  panel width/.store in=\rk@panelwidth,
}
\tikzset{
  rk panel heading/.style={font=\sffamily\bfseries\fontsize{8.4}{10}\selectfont,text=Ink,anchor=north west},
  rk panel row/.style={rk node,text width={\rk@panelwidth cm - 10pt},minimum height=7mm,anchor=north west},
}
% <reportkit-contract>
% {"kind":"figure","description":"Before-and-after comparison with semantic rows.","arguments":[{"name":"options","type":"options","description":"Panel spacing and row layout keys."}],"constraints":[],"example":"\\begin{diagram}[caption={Join comparison.},description={A before and after comparison of data grain.}]\n\\begin{reportcompare}\n\\panel{before}{Before}\n\\panelitem{before}{0}{one order}\n\\panel{after}{After}\n\\panelitem{after}{0}{three items}\n\\transformarrow{join}\n\\end{reportcompare}\n\\end{diagram}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{reportcompare}{O{}}{%
  \begingroup\pgfkeys{/reportkit/compare,gap=2.6,panel width=5.4,#1}%
  \rk@panelindex=0\relax
}{\endgroup}
% <reportkit-contract>
% {"kind":"command","description":"Panel","arguments":[{"name":"id","type":"text","description":"Id."},{"name":"title","type":"text","description":"Title."}],"constraints":[],"example":"\\panel{a}{Example}","stability":"stable","since":"1.0.0","parent":"reportcompare"}
% </reportkit-contract>
\NewDocumentCommand{\panel}{m m}{%
  \ifnum\rk@panelindex>1
    \PackageError{reportkit-grammar}{reportcompare takes exactly two panels}%
      {Declare one \string\panel for the before state and one for the after state.}%
  \fi
  \node[rk panel heading] (#1) at
    ({\rk@panelindex*(\rk@panelwidth+\rk@comparegap)},0) {#2};%
  \expandafter\xdef\csname rk@panelpos@#1\endcsname{\the\rk@panelindex}%
  \advance\rk@panelindex by 1\relax
}
% <reportkit-contract>
% {"kind":"command","description":"Panelitem","arguments":[{"name":"panel","type":"text","description":"Panel."},{"name":"label","type":"text","description":"Label."},{"name":"detail","type":"text","description":"Detail."}],"constraints":[],"example":"\\panelitem{a}{Example}{Example}","stability":"stable","since":"1.0.0","parent":"reportcompare"}
% </reportkit-contract>
\NewDocumentCommand{\panelitem}{m m m}{%
  \@ifundefined{rk@panelpos@#1}{%
    \PackageError{reportkit-grammar}{Unknown reportcompare panel '#1'}%
      {Declare the panel before adding panel items.}%
  }{}%
  \node[rk panel row] at
    ({\csname rk@panelpos@#1\endcsname*(\rk@panelwidth+\rk@comparegap)},
     {-0.55-#2*\rk@rowheight}) {\strut #3};%
}
% <reportkit-contract>
% {"kind":"command","description":"Transformarrow","arguments":[{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\transformarrow{Example}","stability":"stable","since":"1.0.0","parent":"reportcompare"}
% </reportkit-contract>
\NewDocumentCommand{\transformarrow}{m}{%
  \draw[rk edge flow]
    ({\rk@panelwidth+0.25},-1.1) -- ({\rk@panelwidth+\rk@comparegap-0.25},-1.1)
    node[rk transition label,align=center,text width=2.4cm] {#1};%
}

% -----------------------------------------------------------------------------
% Parallel event timelines
% -----------------------------------------------------------------------------
\newcommand{\rk@tracks}{}
\newcommand{\rk@trackspan}{12.0}
\newcommand{\rk@trackgap}{1.6}
\newcommand{\rk@watermarklabelposition}{below}
\newcommand{\rk@watermarklabelwidth}{}
\newcommand{\rk@watermarklabelanchor}{}
\newcount\rk@trackindex
\newcount\rk@trackquery
\pgfkeys{
  /reportkit/timeline/.is family,
  /reportkit/timeline,
  tracks/.store in=\rk@tracks,
  span/.store in=\rk@trackspan,
  track gap/.store in=\rk@trackgap,
}
\pgfkeys{
  /reportkit/timeline/watermark/.is family,
  /reportkit/timeline/watermark,
  label-position/.store in=\rk@watermarklabelposition,
  label-width/.store in=\rk@watermarklabelwidth,
  label-anchor/.store in=\rk@watermarklabelanchor,
  .unknown/.code={\PackageError{reportkit-grammar}{Unknown watermark key '\pgfkeyscurrentname'}{Use label-position=above|below|left|right, label-width=<length>, or label-anchor=<TikZ anchor>.}}
}
\tikzset{
  rk track axis/.style={Hairline,line width=.6pt,-{Stealth[length=4pt]}},
  rk track label/.style={font=\sffamily\fontsize{7.2}{8.5}\selectfont,text=Muted,anchor=east},
  rk event mark/.style={circle,draw=LinkBlue,fill=Surface,line width=.7pt,inner sep=1.6pt,font=\sffamily\fontsize{6.8}{8}\selectfont,text=Ink},
}
\makeatletter
\newcommand{\rk@findtrack}[1]{%
  \rk@trackindex=0\relax\rk@trackquery=-1\relax
  \def\rk@tracktarget{#1}%
  \expandafter\@for\expandafter\rk@trackname\expandafter:=\rk@tracks\do{%
    \edef\rk@trackcandidate{\rk@trackname}%
    \ifx\rk@trackcandidate\rk@tracktarget
      \global\rk@trackquery=\rk@trackindex
    \fi
    \advance\rk@trackindex by 1\relax
  }%
  \ifnum\rk@trackquery<0
    \PackageError{reportkit-grammar}{Unknown reporttimeline track '#1'}%
      {Declare it in the tracks key before using \string\event.}%
    \rk@trackquery=0\relax
  \fi
}
\newcommand{\rk@drawtracks}{%
  \rk@trackindex=0\relax
  \expandafter\@for\expandafter\rk@trackname\expandafter:=\rk@tracks\do{%
    \draw[rk track axis] (0,{-\the\rk@trackindex*\rk@trackgap}) --
      (\rk@trackspan,{-\the\rk@trackindex*\rk@trackgap});%
    \node[rk track label] at (-0.2,{-\the\rk@trackindex*\rk@trackgap}) {\rk@trackname};%
    \advance\rk@trackindex by 1\relax
  }%
}
% <reportkit-contract>
% {"kind":"figure","description":"Events placed on one or more normalized time tracks.","arguments":[{"name":"options","type":"options","description":"Track, span, and label-layout keys."}],"constraints":[],"example":"\\begin{diagram}[caption={Event timeline.},description={Two events on one time track.}]\n\\begin{reporttimeline}[tracks={Event time}]\n\\event{Event time}{.2}{A}\n\\event{Event time}{.8}{B}\n\\watermark{Event time}{.6}{close}\n\\end{reporttimeline}\n\\end{diagram}","stability":"stable","since":"1.0.0"}
% </reportkit-contract>
\NewDocumentEnvironment{reporttimeline}{O{}}{%
  \begingroup\pgfkeys{/reportkit/timeline,tracks={},span=12.0,track gap=1.6,#1}%
  \ifstrempty{\rk@tracks}{%
    \PackageError{reportkit-grammar}{reporttimeline requires tracks={...}}%
      {Provide one or more comma-separated track names.}%
  }{}%
  \rk@drawtracks
}{\endgroup}
% <reportkit-contract>
% {"kind":"command","description":"Event","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"track","type":"text","description":"Track."},{"name":"position","type":"text","description":"Position."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\event[]{a}{1}{Example}","stability":"stable","since":"1.0.0","parent":"reporttimeline"}
% </reportkit-contract>
\NewDocumentCommand{\event}{O{} m m m}{%
  \rk@findtrack{#2}%
  \node[rk event mark,#1] at ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap}) {#4};%
}
% <reportkit-contract>
% {"kind":"command","description":"Skewarrow","arguments":[{"name":"source_track","type":"text","description":"Source track."},{"name":"source_position","type":"text","description":"Source position."},{"name":"target_track","type":"text","description":"Target track."},{"name":"target_position","type":"text","description":"Target position."}],"constraints":[],"example":"\\skewarrow{a}{Example}{b}{Example}","stability":"stable","since":"1.0.0","parent":"reporttimeline"}
% </reportkit-contract>
\NewDocumentCommand{\skewarrow}{m m m m}{%
  \rk@findtrack{#1}\edef\rk@skewfrom{\the\rk@trackquery}%
  \rk@findtrack{#3}\edef\rk@skewto{\the\rk@trackquery}%
  \draw[Hairline,line width=.5pt,densely dashed,-{Stealth[length=4pt]}]
    ({#2*\rk@trackspan},{-\rk@skewfrom*\rk@trackgap+0.18}) --
    ({#4*\rk@trackspan},{-\rk@skewto*\rk@trackgap-0.18});%
}
% <reportkit-contract>
% {"kind":"command","description":"Watermark","arguments":[{"name":"options","type":"options","description":"Options."},{"name":"start","type":"text","description":"Start."},{"name":"end","type":"text","description":"End."},{"name":"label","type":"text","description":"Label."}],"constraints":[],"example":"\\watermark[]{1}{1}{Example}","stability":"stable","since":"1.0.0","parent":"reporttimeline"}
% </reportkit-contract>
\NewDocumentCommand{\watermark}{O{} m m m}{%
  \def\rk@watermarklabelposition{below}\def\rk@watermarklabelwidth{}\def\rk@watermarklabelanchor{}%
  \pgfkeys{/reportkit/timeline/watermark,#1}%
  \rk@findtrack{#2}%
  \draw[LinkBlue,line width=.8pt]
    ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap-0.42}) --
    ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap+0.42});%
  \tikzset{rk watermark label/.style={rk transition label}}%
  \expandafter\ifstrempty\expandafter{\rk@watermarklabelwidth}{}{\tikzset{rk watermark label/.append style={text width=\rk@watermarklabelwidth,align=center}}}%
  \expandafter\ifstrempty\expandafter{\rk@watermarklabelanchor}{}{\tikzset{rk watermark label/.append style={anchor=\rk@watermarklabelanchor}}}%
  \expandafter\ifstrequal\expandafter{\rk@watermarklabelposition}{above}{%
    \node[rk watermark label,above=2pt] at
      ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap+0.42}) {#4};%
  }{\expandafter\ifstrequal\expandafter{\rk@watermarklabelposition}{below}{%
    \node[rk watermark label,below=2pt] at
      ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap-0.42}) {#4};%
  }{\expandafter\ifstrequal\expandafter{\rk@watermarklabelposition}{left}{%
    \node[rk watermark label,left=2pt] at
      ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap}) {#4};%
  }{\expandafter\ifstrequal\expandafter{\rk@watermarklabelposition}{right}{%
    \node[rk watermark label,right=2pt] at
      ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap}) {#4};%
  }{%
    \PackageError{reportkit-grammar}{Invalid watermark label-position '\rk@watermarklabelposition'}{Use above, below, left, or right.}%
    \node[rk watermark label,below=2pt] at
      ({#3*\rk@trackspan},{-\the\rk@trackquery*\rk@trackgap-0.42}) {#4};%
  }}}}%
}
\makeatother

\endinput
