% ReportKit v1.10.0 -- graphstate/gridstate algorithm-visualization primitives
%
% Implements Phase 2's graph/grid pair (spec sections 8-9) of
% docs/superpowers/specs/2026-09-16-reportkit-algorithm-visualization-primitives-spec.md:
%   (1) `graphstate` -- graph TRAVERSAL state (node visitation status plus
%       directed edges), distinct from reportkit-process.sty's `reportnetwork`
%       which is relationship-centric, not algorithm-state-centric;
%   (2) `gridstate` -- 2D grid algorithms (flood fill, maze traversal, matrix
%       DP, connected cells), with deterministic 1-based row/column placement.
%
% This module is \RequirePackage'd by reportkit-algorithm-viz.sty itself,
% right before that file's own \endinput, exactly as reportkit-diagrams.sty
% loads reportkit-structure.sty from within itself: it draws into the same
% already-open `diagram` tikzpicture and reuses reportkit-algorithm-viz.sty's
% already-asserted style-token contract and its `rk algo state <name>` /
% `rk algo cell` / `rk algo container` styles and \rk@setalgostate helper, so
% it must NOT call \RKAssertStyleTokens or \RequirePackage{reportkit-algorithm-viz}
% itself -- by the time this file is read, both have already happened.
%
% Per the spec's section 2.3 (composition before specialization), graphstate
% is deliberately standalone: BFS/DFS explanations are left to a document
% author pairing graphstate with queuestate/stackstate inside the same
% `diagram` or `algorithmtrace` snapshot, not a separate BFS/DFS primitive.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-algorithm-graph}[2026/09/17 v1.0.0 ReportKit graphstate/gridstate algorithm-visualization primitives]
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,backgrounds}
\RequirePackage{xparse}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox}

\makeatletter

% -----------------------------------------------------------------------------
% graphstate -- graph traversal state: node visitation status + directed
% edges, automatically laid out on a grid (mirrors reportkit-process.sty's
% \networknode grid layout). Node coloring reuses the shared
% `rk algo state <name>` overlay via \rk@setalgostate, exactly like
% arraystate's \cell; edges get their own small token-driven style rather
% than a hard-coded color, since "edge" is not part of the shared state
% vocabulary.
% -----------------------------------------------------------------------------
\tikzset{
  rk algo graph node/.style={
    draw=\RKTokAlgorithmCellDraw,fill=\RKTokAlgorithmCellFill,text=\RKTokAlgorithmCellText,\RKTokAlgorithmCellLineStyle,
    rectangle,rounded corners=\RKTokAlgorithmCellRounding,
    minimum height=\RKTokAlgorithmCellMinSize,text width=\RKTokAlgorithmGraphNodeWidth,
    inner sep=\RKTokAlgorithmCellPad,font=\RKTokAlgorithmCellFont,align=center
  },
  rk algo graph edge/.style={rk edge,draw=\RKTokAlgorithmGraphEdgeColor,line width=\RKTokAlgorithmGraphEdgeWidth},
}

\newcount\rk@graphindex
\newcommand{\rk@graphcolumns}{4}
\newcommand{\rk@graphxstep}{3.3}
\newcommand{\rk@graphystep}{2.1}
\pgfkeys{
  /reportkit/graphstate/.is family,
  /reportkit/graphstate,
  columns/.store in=\rk@graphcolumns,
  x spacing/.store in=\rk@graphxstep,
  y spacing/.store in=\rk@graphystep,
}

% Automatic grid layout is deliberately the only placement strategy in this
% first implementation (spec section 8.3: "the first implementation can
% reuse ReportKit's existing semantic node and edge styles"). Authors do not
% supply coordinates; \graphedge resolves source/target purely by the node
% ids \graphnode already declared, which TikZ can resolve anywhere later in
% the same picture regardless of TeX grouping (see \networkedge).
% <reportkit-contract>
% {"kind":"figure","description":"Graph traversal state -- node visitation status and directed edges -- distinct from reportnetwork's static relationship structure.","arguments":[{"name":"options","type":"options","description":"columns=, x spacing=, and y spacing= automatic grid-layout keys."}],"constraints":[],"example":"\\begin{diagram}[type=graph,caption={BFS frontier.},description={A start node has been visited, its current neighbor is being processed, one neighbor is queued as frontier, and one neighbor is unseen.}]\n\\begin{graphstate}\n\\graphnode[state=visited]{A}{Start}\n\\graphnode[state=current]{B}{Current}\n\\graphnode[state=frontier]{C}{Queued}\n\\graphnode[state=unseen]{D}{Unseen}\n\\graphedge{A}{B}\n\\graphedge{B}{C}\n\\graphedge{B}{D}\n\\end{graphstate}\n\\end{diagram}","stability":"experimental","since":"1.10.0"}
% </reportkit-contract>
\NewDocumentEnvironment{graphstate}{O{}}{%
  \begingroup
  \pgfkeys{/reportkit/graphstate,columns=4,x spacing=3.3,y spacing=2.1,#1}%
  \rk@graphindex=0\relax
}{%
  \endgroup
}

% <reportkit-contract>
% {"kind":"command","description":"Place one graph node on the automatic layout grid with a shared algorithm state.","arguments":[{"name":"options","type":"options","description":"state= one of the nine shared algorithm states."},{"name":"id","type":"text","description":"Node id, referenced later by graphedge."},{"name":"label","type":"text","description":"Node label."}],"constraints":[{"code": "inside_graphstate", "description": "Only valid inside graphstate."}],"example":"\\graphnode[state=current]{B}{Current}","stability":"experimental","since":"1.10.0","parent":"graphstate"}
% </reportkit-contract>
\NewDocumentCommand{\graphnode}{O{} m m}{%
  \pgfkeys{/reportkit/algocell,state={},#1}%
  \rk@setalgostate{\rk@algocellstate}%
  \pgfmathsetmacro{\rk@graphx}{mod(\the\rk@graphindex,\rk@graphcolumns)*\rk@graphxstep}%
  \pgfmathsetmacro{\rk@graphy}{-floor(\the\rk@graphindex/\rk@graphcolumns)*\rk@graphystep}%
  \node[rk algo graph node\rk@algostateoverlay] (#2) at (\rk@graphx,\rk@graphy) {\strut #3};%
  \advance\rk@graphindex by 1\relax
}

% <reportkit-contract>
% {"kind":"command","description":"Draw a directed edge between two previously declared graph node ids.","arguments":[{"name":"source","type":"text","description":"Source node id."},{"name":"target","type":"text","description":"Target node id."}],"constraints":[{"code": "inside_graphstate", "description": "Only valid inside graphstate."}, {"code": "known_node_ids", "description": "Both ids must already be declared with graphnode."}],"example":"\\graphedge{A}{B}","stability":"experimental","since":"1.10.0","parent":"graphstate"}
% </reportkit-contract>
\NewDocumentCommand{\graphedge}{m m}{%
  \draw[rk algo graph edge] (#1) -- (#2);%
}

% -----------------------------------------------------------------------------
% gridstate -- 2D grid algorithms (flood fill, maze traversal, matrix DP,
% connected cells). Cells reuse `rk algo cell` and the shared state overlay
% outright -- a grid cell is structurally the same as an arraystate cell,
% just placed on two arithmetic axes instead of one -- so this family needs
% no chrome tokens of its own. The optional bordering rectangle reuses the
% existing `rk algo container` style.
% -----------------------------------------------------------------------------
\newcommand{\rk@gridrowsvalue}{}
\newcommand{\rk@gridcolumnsvalue}{}
\newcommand{\rk@gridcellsize}{1.05}
\pgfkeys{
  /reportkit/gridstate/.is family,
  /reportkit/gridstate,
  rows/.store in=\rk@gridrowsvalue,
  columns/.store in=\rk@gridcolumnsvalue,
  cell size/.store in=\rk@gridcellsize,
}

% #1 the 1-based index being checked, #2 the declared row/column count
% (itself a plain digit-text macro, so it also prints correctly inside the
% error message), #3 the axis name used in the error message.
\newcommand{\rk@gridcheckindex}[3]{%
  \ifnum#1<1\relax
    \PackageError{reportkit-algorithm-graph}{gridstate #3 index #1 is out of range}{Use a 1-based #3 between 1 and #2.}%
  \fi
  \ifnum#1>#2\relax
    \PackageError{reportkit-algorithm-graph}{gridstate #3 index #1 exceeds the declared #3 count #2}{Increase #3= in gridstate's options, or use a smaller index.}%
  \fi
}

% <reportkit-contract>
% {"kind":"figure","description":"2D grid of cells for flood fill, maze traversal, matrix DP, and connected-cell algorithms, with deterministic 1-based row/column placement.","arguments":[{"name":"options","type":"options","description":"rows= and columns= (required) plus cell size= layout keys."}],"constraints":[{"code": "requires_rows_columns", "description": "rows= and columns= must be provided."}],"example":"\\begin{diagram}[type=grid,caption={Flood fill.},description={A four by five grid with a flood-fill frontier expanding from the top-left corner.}]\n\\begin{gridstate}[rows=4,columns=5]\n\\gridcell{1}{1}[state=visited]\n\\gridcell{1}{2}[state=current]\n\\gridcell{2}{2}[state=frontier]\n\\gridcell{3}{3}[state=blocked]\n\\end{gridstate}\n\\end{diagram}","stability":"experimental","since":"1.10.0"}
% </reportkit-contract>
\NewDocumentEnvironment{gridstate}{O{}}{%
  \begingroup
  \pgfkeys{/reportkit/gridstate,rows={},columns={},cell size=1.05,#1}%
  \ifstrempty{\rk@gridrowsvalue}{%
    \PackageError{reportkit-algorithm-graph}{gridstate requires rows=}{Provide rows=<n>, the number of grid rows.}%
    \def\rk@gridrowsvalue{1}%
  }{}%
  \ifstrempty{\rk@gridcolumnsvalue}{%
    \PackageError{reportkit-algorithm-graph}{gridstate requires columns=}{Provide columns=<n>, the number of grid columns.}%
    \def\rk@gridcolumnsvalue{1}%
  }{}%
  \pgfmathsetmacro{\rk@gridxmin}{-0.5*\rk@gridcellsize}%
  \pgfmathsetmacro{\rk@gridxmax}{(\rk@gridcolumnsvalue-1)*\rk@gridcellsize+0.5*\rk@gridcellsize}%
  \pgfmathsetmacro{\rk@gridymin}{-(\rk@gridrowsvalue-1)*\rk@gridcellsize-0.5*\rk@gridcellsize}%
  \pgfmathsetmacro{\rk@gridymax}{0.5*\rk@gridcellsize}%
  \begin{pgfonlayer}{background}
    \draw[rk algo container] (\rk@gridxmin,\rk@gridymin) rectangle (\rk@gridxmax,\rk@gridymax);
  \end{pgfonlayer}
}{%
  \endgroup
}

% <reportkit-contract>
% {"kind":"command","description":"Place one grid cell at a 1-based row/column position with an optional shared algorithm state.","arguments":[{"name":"row","type":"text","description":"1-based row index."},{"name":"column","type":"text","description":"1-based column index."},{"name":"options","type":"options","description":"state= one of the nine shared algorithm states."}],"constraints":[{"code": "inside_gridstate", "description": "Only valid inside gridstate."}, {"code": "index_within_bounds", "description": "row and column must fall within the declared rows= and columns=."}],"example":"\\gridcell{1}{2}[state=current]","stability":"experimental","since":"1.10.0","parent":"gridstate"}
% </reportkit-contract>
\NewDocumentCommand{\gridcell}{m m O{}}{%
  \pgfkeys{/reportkit/algocell,state={},#3}%
  \rk@setalgostate{\rk@algocellstate}%
  \rk@gridcheckindex{#1}{\rk@gridrowsvalue}{row}%
  \rk@gridcheckindex{#2}{\rk@gridcolumnsvalue}{column}%
  \pgfmathsetmacro{\rk@gridx}{(#2-1)*\rk@gridcellsize}%
  \pgfmathsetmacro{\rk@gridy}{-(#1-1)*\rk@gridcellsize}%
  \edef\rk@gridcellname{rkgridcell-#1-#2}%
  \node[rk algo cell\rk@algostateoverlay] (\rk@gridcellname) at (\rk@gridx,\rk@gridy) {\strut};%
}

\makeatother
\endinput
