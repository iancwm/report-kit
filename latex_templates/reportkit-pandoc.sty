% ReportKit Pandoc compatibility layer.
% Keep generated Markdown support in one tracked package so section and book
% builds cannot acquire different ad-hoc preambles.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportkit-pandoc}[2026/09/06 v1.5.0 Pandoc compatibility]
\RequirePackage{iftex}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{fancyvrb}
\RequirePackage[htt]{hyphenat}
\IfFileExists{xurl.sty}{\RequirePackage{xurl}}{\RequirePackage{url}}

% Pandoc's current LaTeX writer emits this helper for compact lists.
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{3em}
\hbadness=4000

% Tables are loaded only when the build template declares that the input uses
% them. This avoids longtable's footnote/microtype diagnostics in table-free
% documents while keeping the generated Pandoc contract available.
\makeatletter
\@ifundefined{ifGuideUsesTables}{\newif\ifGuideUsesTables\GuideUsesTablesfalse}{}
\makeatother
\ifGuideUsesTables
  \RequirePackage{longtable,booktabs,array,calc}
  \makeatletter
  \patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
  \makeatother
  \IfFileExists{footnotehyper.sty}{\RequirePackage{footnotehyper}}{\RequirePackage{footnote}}
  \makesavenoteenv{longtable}
\fi

% Fenced code and syntax highlighting emitted by Pandoc. The token macros are
% intentionally redundant with weight/italic treatment so grayscale output
% remains intelligible.
\newcommand{\VerbBar}{|}
\newcommand{\VERB}{\Verb[commandchars=\\\{\}]}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\}}
\newenvironment{Shaded}{}{}
