{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reportkit:schema:diagnostic-envelope:1.0.0",
  "title": "ReportKit diagnostic envelope",
  "type": "object",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "type", "severity", "message", "remediation", "primitive", "source", "docs", "candidates", "details"],
      "properties": {
        "code": {"type": "string", "pattern": "^RK_[A-Z0-9_]+$"},
        "type": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1},
        "remediation": {"type": "string", "minLength": 1},
        "primitive": {"type": ["string", "null"]},
        "source": {"type": ["object", "null"]},
        "docs": {"type": ["string", "null"]},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    },
    "target": {
      "description": "The TARGET line (agent reasoning loop spec §4.1): the project's declared or defaulted publication target.",
      "type": "object",
      "properties": {
        "line": {"type": "string"},
        "publication_type": {"type": "string"},
        "theme": {"type": "string"},
        "renderer": {"type": "string"},
        "source_mode": {"enum": ["tex", "markdown"]},
        "declared_by": {"enum": ["publication.yaml", "tex-class-options", "default"]},
        "intent_path": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "next_step": {
      "description": "The next command in the reasoning loop, or the remediation command after a failed gate.",
      "type": "object",
      "properties": {"command": {"type": "string"}, "reason": {"type": "string"}},
      "additionalProperties": true
    }
  },
  "required": ["schema_version", "passed", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "passed": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "target": {
      "anyOf": [
        {"$ref": "#/$defs/target"},
        {"type": "string", "description": "init only: the scaffolded project path (v1.x); init reports its loop target as publication_target."}
      ]
    },
    "publication_target": {"$ref": "#/$defs/target"},
    "next_step": {"$ref": "#/$defs/next_step"}
  },
  "additionalProperties": true
}
