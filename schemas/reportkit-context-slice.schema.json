{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reportkit:schema:context-slice:1.0.0",
  "title": "ReportKit progressive-disclosure context slice",
  "type": "object",
  "required": [
    "schema_version", "passed", "diagnostics", "contract_version",
    "reportkit_version", "revision", "slice", "estimated_tokens",
    "context_budget", "content"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "passed": {"const": true},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "contract_version": {"type": "string"},
    "reportkit_version": {"type": "string"},
    "revision": {"type": "string"},
    "slice": {"enum": ["quickstart", "selection", "primitives", "authoring", "commands", "toolchain"]},
    "estimated_tokens": {"type": "integer", "minimum": 1},
    "context_budget": {
      "type": "object",
      "required": ["accounting", "always_loaded", "always_loaded_ceiling", "slices"],
      "properties": {
        "accounting": {"const": "ceil(utf8_bytes / 4)"},
        "always_loaded": {"const": "quickstart"},
        "always_loaded_ceiling": {"const": 2000},
        "slices": {"type": "object"}
      },
      "additionalProperties": false
    },
    "content": {"type": "object"},
    "target": {"$ref": "#/$defs/target"},
    "next_step": {"$ref": "#/$defs/next_step"}
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "description": "The TARGET line (agent reasoning loop spec §4.1): the project's declared or defaulted publication target.",
      "type": "object",
      "properties": {
        "line": {"type": "string"},
        "publication_type": {"type": "string"},
        "theme": {"type": "string"},
        "renderer": {"type": "string"},
        "source_mode": {"enum": ["tex", "markdown"]},
        "declared_by": {"enum": ["publication.yaml", "tex-class-options", "default"]},
        "intent_path": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "next_step": {
      "description": "The next command in the reasoning loop, or the remediation command after a failed gate.",
      "type": "object",
      "properties": {"command": {"type": "string"}, "reason": {"type": "string"}},
      "additionalProperties": true
    }
  }
}
