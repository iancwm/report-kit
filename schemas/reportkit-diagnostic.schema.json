{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reportkit:schema:diagnostic:1.0.0",
  "title": "ReportKit diagnostic",
  "type": "object",
  "required": ["code", "type", "severity", "message", "remediation", "primitive", "source", "docs", "candidates", "details"],
  "properties": {
    "code": {"type": "string", "pattern": "^RK_[A-Z0-9_]+$"},
    "type": {"type": "string", "minLength": 1},
    "severity": {"enum": ["error", "warning", "info"]},
    "message": {"type": "string", "minLength": 1},
    "remediation": {"type": "string", "minLength": 1},
    "primitive": {"type": ["string", "null"]},
    "source": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["file", "line", "line_end"],
          "properties": {
            "file": {"type": ["string", "null"]},
            "line": {"type": ["integer", "null"], "minimum": 1},
            "line_end": {"type": ["integer", "null"], "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "docs": {"type": ["string", "null"]},
    "candidates": {"type": "array", "items": {"type": "string"}},
    "details": {"type": "object"}
  },
  "additionalProperties": true
}
