{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reportkit:schema:context:1.0.0",
  "title": "ReportKit capability context",
  "type": "object",
  "required": ["schema_version", "passed", "diagnostics", "contract_version", "reportkit_version", "revision", "selection", "capabilities", "commands", "command_contract", "schemas", "toolchain", "context_budget"],
  "$defs": {
    "font_stack": {
      "type": "object",
      "required": ["body", "heading", "mono"],
      "properties": {
        "body": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "heading": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mono": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "theme_language_support": {
      "type": "object",
      "required": ["verified", "metadata_only", "scripts", "rtl", "locale_typography"],
      "properties": {
        "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}},
        "metadata_only": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}},
        "scripts": {
          "type": "object",
          "required": ["verified", "metadata_only", "font_stacks"],
          "properties": {
            "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"}},
            "metadata_only": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"}},
            "font_stacks": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/font_stack"}}
          },
          "additionalProperties": false
        },
        "rtl": {"const": "unsupported"},
        "locale_typography": {"type": "object", "additionalProperties": {"type": "string"}},
        "text_direction": {"type": "array", "items": {"const": "ltr"}},
        "missing_glyph": {"type": "object", "required": ["strict", "fallback"]}
      },
      "additionalProperties": false
    },
    "renderer_language_support": {
      "type": "object",
      "required": ["catalog_language", "text_direction", "rtl", "locale_typography", "missing_glyph"],
      "properties": {
        "catalog_language": {"const": "supported"},
        "text_direction": {"type": "array", "items": {"const": "ltr"}},
        "rtl": {"const": "unsupported"},
        "locale_typography": {"type": "object"},
        "missing_glyph": {"type": "object", "required": ["strict", "fallback"]}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "type", "severity", "message", "remediation", "primitive", "source", "docs", "candidates", "details"],
      "properties": {
        "code": {"type": "string", "pattern": "^RK_[A-Z0-9_]+$"},
        "type": {"type": "string"},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string"},
        "remediation": {"type": "string"},
        "primitive": {"type": ["string", "null"]},
        "source": {"type": ["object", "null"]},
        "docs": {"type": ["string", "null"]},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    },
    "availability": {
      "type": "object",
      "required": ["publication_types", "themes", "renderers"],
      "properties": {
        "publication_types": {"type": "array", "items": {"type": "string"}},
        "themes": {"type": "array", "items": {"type": "string"}},
        "renderers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": ["name", "type", "required", "default", "description", "specifier"],
      "properties": {
        "name": {"type": "string"}, "type": {"type": "string"}, "required": {"type": "boolean"},
        "default": {}, "description": {"type": "string"}, "specifier": {"type": "string"},
        "position": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "primitive": {
      "type": "object",
      "required": ["name", "kind", "signature", "source_signature", "arity", "arguments", "constraints", "example", "available_in", "stability", "since", "description", "contract_pointer", "docs", "source"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["callout", "figure", "chart", "composition", "command"]},
        "signature": {"type": "string"}, "source_signature": {"type": "string"},
        "arity": {"type": "object", "required": ["required", "optional"], "properties": {"required": {"type": "integer"}, "optional": {"type": "integer"}}, "additionalProperties": false},
        "arguments": {"type": "array", "items": {"$ref": "#/$defs/argument"}},
        "constraints": {"type": "array", "items": {"type": "object"}},
        "example": {"type": "string", "minLength": 1},
        "available_in": {"$ref": "#/$defs/availability"},
        "stability": {"enum": ["stable", "experimental", "deprecated"]},
        "since": {"type": "string"}, "description": {"type": "string"},
        "contract_pointer": {"type": "string", "pattern": "^#/capabilities/primitives/"},
        "docs": {"type": "string"},
        "source": {"type": "object"}, "parent": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "passed": {"const": true},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "contract_version": {"const": "1.1.0"},
    "reportkit_version": {"const": "1.9.3"},
    "revision": {"type": "string"},
    "selection": {
      "type": "object",
      "properties": {
        "language_support": {
          "allOf": [
            {"$ref": "#/$defs/theme_language_support"},
            {"required": ["text_direction", "missing_glyph"]}
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["publication_types", "themes", "renderers", "primitives", "authoring"],
      "properties": {
        "publication_types": {"type": "object"},
        "themes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["language_support"],
            "properties": {"language_support": {"$ref": "#/$defs/theme_language_support"}}
          }
        },
        "renderers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["language_support"],
            "properties": {"language_support": {"$ref": "#/$defs/renderer_language_support"}}
          }
        },
        "authoring": {
          "type": "object",
          "required": ["mode", "document_template", "chart_prelude", "chart_export", "markdown_raw_tex", "trusted_escape_hatches"]
        },
        "primitives": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/primitive"}}
        }
      },
      "additionalProperties": false
    },
    "commands": {"type": "object", "additionalProperties": {"type": "string"}},
    "command_contract": {"type": "object"}, "schemas": {"type": "object"}, "toolchain": {"type": "object"},
    "context_budget": {
      "type": "object",
      "required": ["accounting", "always_loaded", "always_loaded_ceiling", "slices"],
      "properties": {
        "accounting": {"const": "ceil(utf8_bytes / 4)"},
        "always_loaded": {"const": "quickstart"},
        "always_loaded_ceiling": {"const": 2000},
        "slices": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "estimated_tokens", "loading"],
            "properties": {
              "description": {"type": "string"},
              "estimated_tokens": {"type": "integer", "minimum": 1},
              "loading": {"enum": ["always", "on-demand"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
